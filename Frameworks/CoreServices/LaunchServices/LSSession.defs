/*
 * SPDX-License-Identifier: BSD-2-Clause
 * Copyright (c) 2026 The Minkar contributors
 * Part of Minkar.
 *
 * LaunchServices' session: the MIG interface of launchservicesd (see
 * LSSession.h). Subsystem 29100; the window server's is 29000.
 */

subsystem LSSession 29100;

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

userprefix lss_;
serverprefix lsd_;

import "LSSessionTypes.h";

type ls_app_t = struct[182] of uint32_t
	ctype: LSSessionApp;
type ls_app_list_t = array[*:64] of ls_app_t;
type ls_file_t = struct[18] of uint32_t
	ctype: LSSessionFile;
type ls_path_t = struct[256] of uint32_t
	ctype: LSSessionPath;
type ls_path_list_t = array[*:16] of ls_path_t;
type ls_uti_t = struct[32] of uint32_t
	ctype: ls_uti_t;
type ls_bytes_t = array[*:16384] of char;

routine check_in(
	server			: mach_port_t;
	ServerAuditToken token	: audit_token_t;
	port			: mach_port_make_send_t;
	app			: ls_app_t;
	out result		: int32_t;
	out serial		: uint32_t);

routine copy_apps(
	server			: mach_port_t;
	out apps		: ls_app_list_t);

routine set_front(
	server			: mach_port_t;
	ServerAuditToken token	: audit_token_t;
	pid			: int32_t;
	out result		: int32_t);

routine activate(
	server			: mach_port_t;
	ServerAuditToken token	: audit_token_t;
	pid			: int32_t;
	options			: uint32_t;
	out result		: int32_t);

routine quit(
	server			: mach_port_t;
	ServerAuditToken token	: audit_token_t;
	pid			: int32_t;
	out result		: int32_t);

/* Interface version 3: the applications installed and opening. */
routine copy_handlers(
	server			: mach_port_t;
	file			: ls_file_t;
	out result		: int32_t;
	out uti			: ls_uti_t;
	out apps		: ls_path_list_t);

routine copy_app_for_bundle_id(
	server			: mach_port_t;
	bundle_id		: ls_path_t;
	out result		: int32_t;
	out app			: ls_path_t);

routine register_app(
	server			: mach_port_t;
	path			: ls_path_t;
	out result		: int32_t);

routine open_urls(
	server			: mach_port_t;
	ServerAuditToken token	: audit_token_t;
	app			: ls_path_t;
	urls			: ls_bytes_t;
	flags			: uint32_t;
	out result		: int32_t;
	out running		: int32_t);

/* Interface version 4: hiding. */
routine set_hidden(
	server			: mach_port_t;
	ServerAuditToken token	: audit_token_t;
	pid			: int32_t;
	hidden			: int32_t;
	out result		: int32_t);
