<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ravynos.getty.console</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/getty</string>
		<!-- 3wire: no modem lines (CLOCAL); with std.9600 the console
		     looked carrier-less and getty's writes waited forever. -->
		<string>3wire</string>
		<string>console</string>
	</array>
	<!-- Not at load: kextstart starts it once the drivers are attached, so
	     no kernel message lands after the login prompt. Then kept alive. -->
	<key>KeepAlive</key>
	<dict>
		<key>AfterInitialDemand</key>
		<true/>
	</dict>
</dict>
</plist>
