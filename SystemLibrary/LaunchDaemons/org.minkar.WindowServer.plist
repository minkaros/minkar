<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.minkar.WindowServer</string>
	<!-- Installed disabled: started, the server takes the screen and the
	     text console is no longer seen on it. Enable it with
	     launchctl load -w (the boottest gate M4-draw does). -->
	<key>Disabled</key>
	<true/>
	<key>ProgramArguments</key>
	<array>
		<string>/System/Library/CoreServices/WindowServer.app/Contents/MacOS/WindowServer</string>
		<!-- SHORTCUT(WS4b): the compositor only (-x), since LoginWindow is
		     not built yet; session start leaves WindowServer in WS4b;
		     taken in WS0. -->
		<string>-x</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>C.UTF-8</string>
	</dict>
	<key>StandardErrorPath</key>
	<string>/var/log/WindowServer.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
