<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The new window server (WindowServer plan, WS4a). It runs next to
	     the legacy one, under its own service name, until the switch
	     (WS4b), when it becomes org.minkar.WindowServer. Installed
	     disabled: started, it takes the screen. Enable it with
	     launchctl load -w (the boottest gate M4-compose does). -->
	<key>Label</key>
	<string>org.minkar.WindowServer.next</string>
	<key>Disabled</key>
	<true/>
	<key>ProgramArguments</key>
	<array>
		<string>/System/Library/PrivateFrameworks/SkyLight.framework/Versions/A/Resources/WindowServer</string>
	</array>
	<!-- As on the reference platform: its own user, not root. IOHIDSystem
	     accepts it through its entitlement (ADR 0001). -->
	<key>UserName</key>
	<string>_windowserver</string>
	<key>GroupName</key>
	<string>_windowserver</string>
	<key>MachServices</key>
	<dict>
		<key>org.minkar.WindowServer.next</key>
		<true/>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>C.UTF-8</string>
	</dict>
	<key>StandardErrorPath</key>
	<string>/var/log/WindowServer/WindowServer.next.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
