<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
 SPDX-License-Identifier: BSD-2-Clause
 Copyright (c) 2026 The Minkar contributors
 Part of Minkar.

 notificationd, the notification center's session service (Atlas.md, 5.6,
 N0): apps' notifications, handed to SystemUIServer to show. Started on
 demand, by the first lookup of its service. As root, with one session for
 the console, as launchservicesd.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.minkar.notificationd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/notificationd</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>org.minkar.notificationd</key>
		<true/>
	</dict>
	<key>StandardErrorPath</key>
	<string>/var/log/notificationd.log</string>
	<key>KeepAlive</key>
	<false/>
</dict>
</plist>
