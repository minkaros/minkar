+/*
+ * Minkar: the graphics mode the kernel gets, from "graphics-mode" in the
+ * boot plist: "WIDTHxHEIGHT" for that mode (or the largest one that fits
+ * in it), "max" for the largest the display offers. Without it the mode
+ * the firmware set stays. The kernel takes over whatever mode is set here.
+ */
+STATIC VOID SetGraphicsMode(VOID)
+{
+    EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP;
+    CONST CHAR8 *want = gBootConfig.GraphicsMode;
+    UINTN wantW = 0, wantH = 0;
+    BOOLEAN max = FALSE;
+
+    if (want[0] == '\0')
+        return;
+    if (EFI_ERROR(gBS->LocateProtocol(&gEfiGraphicsOutputProtocolGuid, NULL, (VOID **)&GOP)))
+        return;
+    if (AsciiStrCmp(want, "max") == 0) {
+        max = TRUE;
+    } else {
+        CONST CHAR8 *x = want;
+        while (*x != '\0' && *x != 'x' && *x != 'X')
+            x++;
+        if (*x == '\0')
+            return;
+        wantW = AsciiStrDecimalToUintn(want);
+        wantH = AsciiStrDecimalToUintn(x + 1);
+    }
+
+    UINT32 best = GOP->Mode->Mode;
+    UINTN bestPixels = 0;
+    Print(UEFI_STR("[] Graphics modes:"));
+    for (UINT32 m = 0; m < GOP->Mode->MaxMode; m++) {
+        EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *mi;
+        UINTN size;
+
+        if (EFI_ERROR(GOP->QueryMode(GOP, m, &size, &mi)))
+            continue;
+        UINTN w = mi->HorizontalResolution, h = mi->VerticalResolution;
+        BOOLEAN usable = mi->PixelFormat != PixelBltOnly;
+        gBS->FreePool(mi);
+        if (!usable)
+            continue;
+        Print(UEFI_STR(" %ux%u"), (UINT32)w, (UINT32)h);
+        if (!max && (w > wantW || h > wantH))
+            continue;
+        if (w * h > bestPixels) {
+            bestPixels = w * h;
+            best = m;
+        }
+    }
+    Print(UEFI_STR("\n"));
+    if (bestPixels == 0 || best == GOP->Mode->Mode)
+        return;
+    if (EFI_ERROR(GOP->SetMode(GOP, best)))
+        Print(UEFI_STR("[] Could not set graphics mode %u\n"), best);
+}
