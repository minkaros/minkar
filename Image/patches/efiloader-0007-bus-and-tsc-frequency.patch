     FdtCreateNode(DTB, "/efi", "platform"); /* IODTPlane:/efi/platform */
     FdtSetProperty(DTB, "/efi/platform", "apple-coprocessor-version", &val, 4);
     FdtSetProperty(DTB, "/efi/platform", "boot-chime-on-last-boot", &val, 4);
