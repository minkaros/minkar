+ * Copyright (c) 2026 The Minkar contributors
+ * Part of Minkar.
+ *
+ * The graphical boot (bootscreen.c) and the boot picker (picker.c).
+ */
+#ifndef __BOOTSCREEN_H
+#define __BOOTSCREEN_H
+
+#include <Protocol/GraphicsOutput.h>
+
+typedef enum {
+    BootKeysNone,       /* the usual boot */
+    BootKeysVerbose,    /* Command-V: verbose mode */
+    BootKeysPicker,     /* Alt: the boot picker */
+} BOOT_KEYS;
+
+/* The keys held, looked at for WaitMs milliseconds. */
+BOOT_KEYS ReadBootKeys(UINTN WaitMs);
+
+/* The boot screen, its bar at Percent; the bar alone moved on. */
+VOID BootScreenShow(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, UINTN Percent);
+VOID BootScreenProgress(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, UINTN Percent);
+
+/* The boot picker: another volume's loader started from it, or the keys
+   for this system's boot (as usual, or verbose). */
+BOOT_KEYS RunPicker(EFI_HANDLE ImageHandle);
+
+EFI_STATUS OpenBootVolume(EFI_FILE_HANDLE *Root);
+
+#endif
