Minkar: the graphical boot. Unless the boot arguments have -v or
Command-V (the Windows key with V on a PC keyboard) is held, the loader
draws the boot screen (black, Minkar's logo from \Minkar\Boot\logo.raw,
a progress bar), keeps its own text for \Minkar\loader.log only, and
gives the kernel a graphics console, which goes on with the bar.

Alt held (or pressed) at power-on shows the boot picker: a row of round
icons (\Minkar\Boot\Picker) with their names in the firmware's font:
this system, verbose mode, other Minkar systems (named by their boot
plist's volume-name), Windows and other EFI loaders; a start button
under the chosen one and restart and shut down buttons at the bottom.
Without the icons it is a list in text. "key-wait" in the boot plist
sets how long the keys are looked for (500 ms). Everything the loader's
files print goes through LogPrint.

diff -ruN a/MdeModulePkg/Application/Loader/bootscreen.c b/MdeModulePkg/Application/Loader/bootscreen.c
--- a/MdeModulePkg/Application/Loader/bootscreen.c	1969-12-31 19:00:00.000000000 -0500
+++ b/MdeModulePkg/Application/Loader/bootscreen.c	2026-11-27 12:56:16.312573594 -0500
@@ -0,0 +1,218 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ * Copyright (c) 2026 The Minkar contributors
+ * Part of Minkar.
+ *
+ * The graphical boot: the keys held at power-on (Alt for the boot picker,
+ * Command-V, the Windows key with V on a PC keyboard, for verbose mode),
+ * and the boot screen: a black screen with Minkar's logo and a progress
+ * bar, which the kernel goes on filling (osfmk/console/boot_progress.c
+ * draws the same bar in the same place).
+ *
+ * The geometry is the boot screen's design at 1920x1080 scaled to the
+ * screen's height: the logo in a box of 156 pixels centred 494 pixels
+ * down, the bar 320x5 pixels from 635 pixels down. The logo comes from
+ * \Minkar\Boot\logo.raw (tools/boot/pngraw.py: BGRX pixels already over
+ * black); the bar is drawn, a capsule in two colours.
+ */
+
+#include "loader.h"
+#include "bootscreen.h"
+#include <Protocol/SimpleTextInEx.h>
+#include <Protocol/GraphicsOutput.h>
+
+#define DESIGN_HEIGHT   1080
+#define LOGO_BOX        156
+#define LOGO_CENTRE_Y   494
+#define BAR_WIDTH       320
+#define BAR_HEIGHT      5
+#define BAR_TOP         635
+
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL kTrack = { 0x59, 0x55, 0x55, 0 };
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL kFill = { 0xf2, 0xf0, 0xf0, 0 };
+
+STATIC UINTN Scale(UINTN Value, UINTN Height)
+{
+    return (Value * Height + DESIGN_HEIGHT / 2) / DESIGN_HEIGHT;
+}
+
+BOOT_KEYS ReadBootKeys(UINTN WaitMs)
+{
+    EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL *In;
+    BOOLEAN Picker = FALSE, Verbose = FALSE;
+
+    if (gST->ConsoleInHandle == NULL ||
+        EFI_ERROR(gBS->HandleProtocol(gST->ConsoleInHandle, &gEfiSimpleTextInputExProtocolGuid, (VOID **)&In)))
+        return BootKeysNone;
+
+    /* Modifier keys alone are reported only with the key state exposed. */
+    EFI_KEY_TOGGLE_STATE State = EFI_TOGGLE_STATE_VALID | EFI_KEY_STATE_EXPOSED;
+    EFI_STATUS Exposed = In->SetState(In, &State);
+    UINT32 Seen = 0;
+    UINTN Strokes = 0;
+    /* A key held since power-on gives no new keystroke (a modifier never
+       repeats): the shift state comes with every answer, keystroke or not
+       (EFI_NOT_READY), and is looked at either way. */
+    for (UINTN Waited = 0; Waited <= WaitMs; Waited += 10) {
+        for (;;) {
+            EFI_KEY_DATA Key;
+            ZeroMem(&Key, sizeof(Key));
+            EFI_STATUS Status = In->ReadKeyStrokeEx(In, &Key);
+            UINT32 Shift = Key.KeyState.KeyShiftState;
+            Seen |= Shift;
+            if (!EFI_ERROR(Status))
+                Strokes++;
+            if (Shift & EFI_SHIFT_STATE_VALID) {
+                if (Shift & (EFI_LEFT_ALT_PRESSED | EFI_RIGHT_ALT_PRESSED))
+                    Picker = TRUE;
+                if ((Shift & (EFI_LEFT_LOGO_PRESSED | EFI_RIGHT_LOGO_PRESSED)) &&
+                    (Key.Key.UnicodeChar == L'v' || Key.Key.UnicodeChar == L'V'))
+                    Verbose = TRUE;
+            }
+            if (EFI_ERROR(Status))
+                break;
+        }
+        gBS->Stall(10 * 1000);
+    }
+    State = EFI_TOGGLE_STATE_VALID;
+    In->SetState(In, &State);
+    Print(UEFI_STR("[] Boot keys: key state exposed %r, shift states seen 0x%x, %u keystrokes\n"),
+        Exposed, Seen, Strokes);
+    return Picker ? BootKeysPicker : Verbose ? BootKeysVerbose : BootKeysNone;
+}
+
+/* The logo, read whole: "MKBI", width, height, then BGRX rows. */
+STATIC EFI_GRAPHICS_OUTPUT_BLT_PIXEL *ReadLogo(UINT32 *Width, UINT32 *Height)
+{
+    EFI_FILE_HANDLE Root, File;
+    UINT8 Header[12];
+    UINTN Size = sizeof(Header);
+    EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Pixels = NULL;
+
+    if (EFI_ERROR(OpenBootVolume(&Root)))
+        return NULL;
+    EFI_STATUS Status = Root->Open(Root, &File, UEFI_STR("\\Minkar\\Boot\\logo.raw"), EFI_FILE_MODE_READ, 0);
+    Root->Close(Root);
+    if (EFI_ERROR(Status))
+        return NULL;
+    if (!EFI_ERROR(File->Read(File, &Size, Header)) && Size == sizeof(Header) &&
+        CompareMem(Header, "MKBI", 4) == 0) {
+        *Width = *(UINT32 *)(Header + 4);
+        *Height = *(UINT32 *)(Header + 8);
+        if (*Width > 0 && *Width <= 2048 && *Height > 0 && *Height <= 2048) {
+            Size = (UINTN)*Width * *Height * sizeof(*Pixels);
+            Pixels = AllocatePool(Size);
+            UINTN Wanted = Size;
+            if (Pixels != NULL && (EFI_ERROR(File->Read(File, &Size, Pixels)) || Size != Wanted)) {
+                FreePool(Pixels);
+                Pixels = NULL;
+            }
+        }
+    }
+    File->Close(File);
+    return Pixels;
+}
+
+/* The logo scaled to Box x Box, each pixel the average of the source
+   pixels it covers (or the nearest one, when it is made larger). */
+STATIC VOID DrawLogo(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, UINTN Width, UINTN Height)
+{
+    UINT32 SourceWidth, SourceHeight;
+    EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Source = ReadLogo(&SourceWidth, &SourceHeight);
+    UINTN Box = Scale(LOGO_BOX, Height);
+
+    if (Source == NULL)
+        return;
+    EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Out = AllocateZeroPool(Box * Box * sizeof(*Out));
+    if (Out != NULL) {
+        for (UINTN y = 0; y < Box; y++) {
+            UINTN y0 = y * SourceHeight / Box, y1 = (y + 1) * SourceHeight / Box;
+            if (y1 <= y0)
+                y1 = y0 + 1;
+            for (UINTN x = 0; x < Box; x++) {
+                UINTN x0 = x * SourceWidth / Box, x1 = (x + 1) * SourceWidth / Box;
+                UINTN R = 0, G = 0, B = 0, N = 0;
+                if (x1 <= x0)
+                    x1 = x0 + 1;
+                for (UINTN sy = y0; sy < y1 && sy < SourceHeight; sy++)
+                    for (UINTN sx = x0; sx < x1 && sx < SourceWidth; sx++) {
+                        EFI_GRAPHICS_OUTPUT_BLT_PIXEL *P = &Source[sy * SourceWidth + sx];
+                        R += P->Red;
+                        G += P->Green;
+                        B += P->Blue;
+                        N++;
+                    }
+                if (N > 0) {
+                    Out[y * Box + x].Red = (UINT8)(R / N);
+                    Out[y * Box + x].Green = (UINT8)(G / N);
+                    Out[y * Box + x].Blue = (UINT8)(B / N);
+                }
+            }
+        }
+        UINTN Top = Scale(LOGO_CENTRE_Y, Height);
+        Top = Top > Box / 2 ? Top - Box / 2 : 0;
+        GOP->Blt(GOP, Out, EfiBltBufferToVideo, 0, 0, (Width - Box) / 2, Top, Box, Box, 0);
+        FreePool(Out);
+    }
+    FreePool(Source);
+}
+
+/*
+ * The bar: a capsule (a rectangle with round ends), filled from the left
+ * to Percent. Each pixel is sampled 4x4 times (in eighths of a pixel) for
+ * its edges, over the black background.
+ */
+STATIC VOID DrawBar(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, UINTN Width, UINTN Height, UINTN Percent)
+{
+    UINTN BarWidth = Scale(BAR_WIDTH, Height), BarHeight = Scale(BAR_HEIGHT, Height);
+    UINTN Left = (Width - BarWidth) / 2, Top = Scale(BAR_TOP, Height);
+    EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Out;
+
+    if (BarHeight < 3)
+        BarHeight = 3;
+    if (Percent > 100)
+        Percent = 100;
+    Out = AllocateZeroPool(BarWidth * BarHeight * sizeof(*Out));
+    if (Out == NULL)
+        return;
+    INTN Radius = (INTN)BarHeight * 4;
+    INTN LeftCentre = (INTN)Left * 8 + Radius, RightCentre = (INTN)(Left + BarWidth) * 8 - Radius;
+    INTN Middle = (INTN)Top * 8 + (INTN)BarHeight * 4;
+    INTN FillEnd = (INTN)Left * 8 + (INTN)(BarWidth * 8 * Percent / 100);
+    for (UINTN y = 0; y < BarHeight; y++)
+        for (UINTN x = 0; x < BarWidth; x++) {
+            UINTN R = 0, G = 0, B = 0;
+            for (INTN j = 0; j < 4; j++)
+                for (INTN i = 0; i < 4; i++) {
+                    INTN sx = (INTN)(Left + x) * 8 + 2 * i + 1, sy = (INTN)(Top + y) * 8 + 2 * j + 1;
+                    INTN dx = sx < LeftCentre ? LeftCentre - sx : sx > RightCentre ? sx - RightCentre : 0;
+                    INTN dy = sy - Middle;
+                    if (dx * dx + dy * dy > Radius * Radius)
+                        continue;
+                    CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL *C = sx < FillEnd ? &kFill : &kTrack;
+                    R += C->Red;
+                    G += C->Green;
+                    B += C->Blue;
+                }
+            Out[y * BarWidth + x].Red = (UINT8)(R / 16);
+            Out[y * BarWidth + x].Green = (UINT8)(G / 16);
+            Out[y * BarWidth + x].Blue = (UINT8)(B / 16);
+        }
+    GOP->Blt(GOP, Out, EfiBltBufferToVideo, 0, 0, Left, Top, BarWidth, BarHeight, 0);
+    FreePool(Out);
+}
+
+VOID BootScreenShow(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, UINTN Percent)
+{
+    EFI_GRAPHICS_OUTPUT_BLT_PIXEL Black = { 0, 0, 0, 0 };
+    UINTN Width = GOP->Mode->Info->HorizontalResolution, Height = GOP->Mode->Info->VerticalResolution;
+
+    GOP->Blt(GOP, &Black, EfiBltVideoFill, 0, 0, 0, 0, Width, Height, 0);
+    DrawLogo(GOP, Width, Height);
+    DrawBar(GOP, Width, Height, Percent);
+}
+
+VOID BootScreenProgress(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, UINTN Percent)
+{
+    DrawBar(GOP, GOP->Mode->Info->HorizontalResolution, GOP->Mode->Info->VerticalResolution, Percent);
+}
