+++ b/MdeModulePkg/Application/Loader/picker.c	2026-11-27 13:23:31.436379712 -0500
@@ -0,0 +1,460 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ * Copyright (c) 2026 The Minkar contributors
+ * Part of Minkar.
+ *
+ * The boot picker, shown when Alt is held at power-on: the system this
+ * loader belongs to (as usual, or in verbose mode), and the other volumes
+ * that can be started: other Minkar systems (their EFI partition has a
+ * kernel cache and its own loader; the name is their boot plist's
+ * "volume-name"), Windows, and any other removable-media loader
+ * (\EFI\BOOT\BOOTX64.EFI). Another volume's loader is started as it is.
+ *
+ * Drawn on black: a row of round icons (\Minkar\Boot\Picker, made by
+ * tools/boot/picker-icons.py) with their names (the firmware's font),
+ * the chosen one on a grey highlight with the start button under it, and
+ * the restart and shut down buttons at the bottom. Left and right choose
+ * an entry, down and up move between the entries and the buttons, Return
+ * starts or presses, Escape goes on as usual. Without the icons (or the
+ * graphics output) it is a list in text.
+ *
+ * The geometry is a design at 1920x1080 scaled to the screen's height.
+ */
+
+#include "loader.h"
+#include "bootscreen.h"
+#include <Library/DevicePathLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Protocol/HiiFont.h>
+#include <Protocol/SimpleTextInEx.h>
+
+#define MAX_ENTRIES     8
+#define DESIGN_HEIGHT   1080
+#define ICON_SIZE       150
+#define ICON_GAP        70
+#define HIGHLIGHT_PAD   16
+#define ROW_CENTRE_Y    470
+#define LABEL_GAP       26
+#define START_SIZE      44
+#define BUTTON_SIZE     40
+#define BUTTON_GAP      56
+#define BUTTONS_Y       960
+
+typedef struct {
+    UINT32 Width, Height;
+    UINT8 *Pixels;              /* BGRA, straight alpha */
+} ICON;
+
+typedef enum { IconMinkar, IconVerbose, IconDisk, IconStart, IconRestart, IconShutdown, IconCount } ICON_KIND;
+
+STATIC CONST CHAR16 *kIconFiles[IconCount] = {
+    UEFI_STR("minkar.raw"), UEFI_STR("verbose.raw"), UEFI_STR("disk.raw"),
+    UEFI_STR("start.raw"), UEFI_STR("restart.raw"), UEFI_STR("shutdown.raw"),
+};
+
+typedef struct {
+    CHAR16 Name[64];
+    EFI_HANDLE Volume;          /* NULL: this system */
+    CONST CHAR16 *Path;
+    BOOT_KEYS Keys;             /* for this system: as usual or verbose */
+    ICON_KIND Icon;
+} PICKER_ENTRY;
+
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL kBlack = { 0, 0, 0, 0 };
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL kHighlight = { 0x4e, 0x4a, 0x4a, 0 };
+STATIC CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL kText = { 0xf2, 0xf0, 0xf0, 0 };
+
+STATIC ICON gIcons[IconCount];
+
+STATIC BOOLEAN FileExists(EFI_FILE_HANDLE Root, CONST CHAR16 *Path)
+{
+    EFI_FILE_HANDLE File;
+
+    if (EFI_ERROR(Root->Open(Root, &File, (CHAR16 *)Path, EFI_FILE_MODE_READ, 0)))
+        return FALSE;
+    File->Close(File);
+    return TRUE;
+}
+
+/* The "volume-name" string of a boot plist, or Fallback. */
+STATIC VOID VolumeName(EFI_FILE_HANDLE Root, CHAR16 *Name, UINTN Size, CONST CHAR16 *Fallback)
+{
+    EFI_FILE_HANDLE File;
+    CHAR8 Plist[EFI_PAGE_SIZE];
+    UINTN Length = sizeof(Plist) - 1;
+
+    StrCpyS(Name, Size, Fallback);
+    if (EFI_ERROR(Root->Open(Root, &File, UEFI_STR("\\Minkar\\org.minkar.boot.plist"), EFI_FILE_MODE_READ, 0)))
+        return;
+    if (!EFI_ERROR(File->Read(File, &Length, Plist))) {
+        Plist[Length] = '\0';
+        CHAR8 *Key = AsciiStrStr(Plist, "<key>volume-name</key>");
+        CHAR8 *Value = Key != NULL ? AsciiStrStr(Key, "<string>") : NULL;
+        CHAR8 *End = Value != NULL ? AsciiStrStr(Value, "</string>") : NULL;
+        if (End != NULL && End - Value - 8 > 0 && (UINTN)(End - Value - 8) < Size) {
+            *End = '\0';
+            AsciiStrToUnicodeStrS(Value + 8, Name, Size);
+        }
+    }
+    File->Close(File);
+}
+
+STATIC UINTN FindEntries(EFI_HANDLE ImageHandle, PICKER_ENTRY *Entries)
+{
+    EFI_LOADED_IMAGE_PROTOCOL *Self = NULL;
+    EFI_HANDLE *Handles = NULL;
+    UINTN Count = 0, N = 0;
+    EFI_FILE_HANDLE Root;
+
+    gBS->HandleProtocol(ImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Self);
+    if (!EFI_ERROR(OpenBootVolume(&Root))) {
+        VolumeName(Root, Entries[0].Name, ARRAY_SIZE(Entries[0].Name), UEFI_STR("Minkar"));
+        Root->Close(Root);
+    } else
+        StrCpyS(Entries[0].Name, ARRAY_SIZE(Entries[0].Name), UEFI_STR("Minkar"));
+    Entries[0].Keys = BootKeysNone;
+    Entries[0].Icon = IconMinkar;
+    StrCpyS(Entries[1].Name, ARRAY_SIZE(Entries[1].Name), UEFI_STR("Verbose mode"));
+    Entries[1].Keys = BootKeysVerbose;
+    Entries[1].Icon = IconVerbose;
+    N = 2;
+
+    if (EFI_ERROR(gBS->LocateHandleBuffer(ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &Count, &Handles)))
+        return N;
+    for (UINTN i = 0; i < Count && N < MAX_ENTRIES; i++) {
+        EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *Fs;
+        if (Self != NULL && Handles[i] == Self->DeviceHandle)
+            continue;
+        if (EFI_ERROR(gBS->HandleProtocol(Handles[i], &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs)) ||
+            EFI_ERROR(Fs->OpenVolume(Fs, &Root)))
+            continue;
+        PICKER_ENTRY *E = &Entries[N];
+        E->Volume = Handles[i];
+        E->Icon = IconDisk;
+        if (FileExists(Root, UEFI_STR("\\Minkar\\kernelcache")) &&
+            FileExists(Root, UEFI_STR("\\EFI\\BOOT\\BOOTX64.EFI"))) {
+            VolumeName(Root, E->Name, ARRAY_SIZE(E->Name), UEFI_STR("Minkar"));
+            E->Path = UEFI_STR("\\EFI\\BOOT\\BOOTX64.EFI");
+            E->Icon = IconMinkar;
+        } else if (FileExists(Root, UEFI_STR("\\EFI\\Microsoft\\Boot\\bootmgfw.efi"))) {
+            StrCpyS(E->Name, ARRAY_SIZE(E->Name), UEFI_STR("Windows"));
+            E->Path = UEFI_STR("\\EFI\\Microsoft\\Boot\\bootmgfw.efi");
+        } else if (FileExists(Root, UEFI_STR("\\EFI\\BOOT\\BOOTX64.EFI"))) {
+            StrCpyS(E->Name, ARRAY_SIZE(E->Name), UEFI_STR("EFI Boot"));
+            E->Path = UEFI_STR("\\EFI\\BOOT\\BOOTX64.EFI");
+        }
+        Root->Close(Root);
+        if (E->Path != NULL)
+            N++;
+    }
+    FreePool(Handles);
+    return N;
+}
+
+/* The icons, read whole: "MKBA", width, height, then BGRA. All or none. */
+STATIC BOOLEAN LoadIcons(VOID)
+{
+    EFI_FILE_HANDLE Root, File;
+    BOOLEAN Ok = TRUE;
+
+    if (EFI_ERROR(OpenBootVolume(&Root)))
+        return FALSE;
+    for (UINTN i = 0; i < IconCount && Ok; i++) {
+        CHAR16 Path[64];
+        UINT8 Header[12];
+        UINTN Size = sizeof(Header);
+        UnicodeSPrint(Path, sizeof(Path), UEFI_STR("\\Minkar\\Boot\\Picker\\%s"), kIconFiles[i]);
+        Ok = FALSE;
+        if (EFI_ERROR(Root->Open(Root, &File, Path, EFI_FILE_MODE_READ, 0)))
+            break;
+        if (!EFI_ERROR(File->Read(File, &Size, Header)) && Size == sizeof(Header) &&
+            CompareMem(Header, "MKBA", 4) == 0) {
+            gIcons[i].Width = *(UINT32 *)(Header + 4);
+            gIcons[i].Height = *(UINT32 *)(Header + 8);
+            if (gIcons[i].Width > 0 && gIcons[i].Width <= 512 && gIcons[i].Height > 0 && gIcons[i].Height <= 512) {
+                Size = (UINTN)gIcons[i].Width * gIcons[i].Height * 4;
+                UINTN Wanted = Size;
+                gIcons[i].Pixels = AllocatePool(Size);
+                Ok = gIcons[i].Pixels != NULL && !EFI_ERROR(File->Read(File, &Size, gIcons[i].Pixels)) &&
+                     Size == Wanted;
+            }
+        }
+        File->Close(File);
+    }
+    Root->Close(Root);
+    return Ok;
+}
+
+STATIC VOID FreeIcons(VOID)
+{
+    for (UINTN i = 0; i < IconCount; i++)
+        if (gIcons[i].Pixels != NULL) {
+            FreePool(gIcons[i].Pixels);
+            gIcons[i].Pixels = NULL;
+        }
+}
+
+STATIC UINTN Scale(UINTN Value, UINTN Height)
+{
+    return (Value * Height + DESIGN_HEIGHT / 2) / DESIGN_HEIGHT;
+}
+
+/* An icon at Size x Size over a plain background: each pixel the average
+   of the source pixels it covers, blended by their alpha. */
+STATIC VOID DrawIcon(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, ICON *Icon, UINTN Left, UINTN Top, UINTN Size,
+                     CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Back)
+{
+    EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Out;
+
+    if (Size == 0 || (Out = AllocatePool(Size * Size * sizeof(*Out))) == NULL)
+        return;
+    for (UINTN y = 0; y < Size; y++) {
+        UINTN y0 = y * Icon->Height / Size, y1 = (y + 1) * Icon->Height / Size;
+        if (y1 <= y0)
+            y1 = y0 + 1;
+        for (UINTN x = 0; x < Size; x++) {
+            UINTN x0 = x * Icon->Width / Size, x1 = (x + 1) * Icon->Width / Size;
+            UINTN R = 0, G = 0, B = 0, A = 0, N = 0;
+            if (x1 <= x0)
+                x1 = x0 + 1;
+            for (UINTN sy = y0; sy < y1 && sy < Icon->Height; sy++)
+                for (UINTN sx = x0; sx < x1 && sx < Icon->Width; sx++) {
+                    UINT8 *P = &Icon->Pixels[(sy * Icon->Width + sx) * 4];
+                    B += P[0] * P[3];
+                    G += P[1] * P[3];
+                    R += P[2] * P[3];
+                    A += P[3];
+                    N++;
+                }
+            /* Premultiplied average, then over the background. */
+            UINTN Cover = N ? A / N : 0;
+            EFI_GRAPHICS_OUTPUT_BLT_PIXEL *O = &Out[y * Size + x];
+            O->Blue = (UINT8)((N ? B / N / 255 : 0) + Back->Blue * (255 - Cover) / 255);
+            O->Green = (UINT8)((N ? G / N / 255 : 0) + Back->Green * (255 - Cover) / 255);
+            O->Red = (UINT8)((N ? R / N / 255 : 0) + Back->Red * (255 - Cover) / 255);
+            O->Reserved = 0;
+        }
+    }
+    GOP->Blt(GOP, Out, EfiBltBufferToVideo, 0, 0, Left, Top, Size, Size, 0);
+    FreePool(Out);
+}
+
+/* A rounded rectangle (the chosen entry's highlight), its corners sampled
+   4x4 times over black. */
+STATIC VOID DrawHighlight(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, UINTN Left, UINTN Top, UINTN Width, UINTN Height,
+                          UINTN Radius, CONST EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Colour)
+{
+    EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Out = AllocateZeroPool(Width * Height * sizeof(*Out));
+
+    if (Out == NULL)
+        return;
+    INTN R8 = (INTN)Radius * 8;
+    for (UINTN y = 0; y < Height; y++)
+        for (UINTN x = 0; x < Width; x++) {
+            UINTN Hits = 0;
+            for (INTN j = 0; j < 4; j++)
+                for (INTN i = 0; i < 4; i++) {
+                    INTN sx = (INTN)x * 8 + 2 * i + 1, sy = (INTN)y * 8 + 2 * j + 1;
+                    INTN cx = sx < R8 ? R8 : sx > (INTN)Width * 8 - R8 ? (INTN)Width * 8 - R8 : sx;
+                    INTN cy = sy < R8 ? R8 : sy > (INTN)Height * 8 - R8 ? (INTN)Height * 8 - R8 : sy;
+                    if ((sx - cx) * (sx - cx) + (sy - cy) * (sy - cy) <= R8 * R8)
+                        Hits++;
+                }
+            Out[y * Width + x].Blue = (UINT8)(Colour->Blue * Hits / 16);
+            Out[y * Width + x].Green = (UINT8)(Colour->Green * Hits / 16);
+            Out[y * Width + x].Red = (UINT8)(Colour->Red * Hits / 16);
+        }
+    GOP->Blt(GOP, Out, EfiBltBufferToVideo, 0, 0, Left, Top, Width, Height, 0);
+    FreePool(Out);
+}
+
+/* A name in the firmware's font, centred on CentreX, made Zoom times
+   larger (each pixel repeated) on large screens. The firmware may give a
+   larger image than the text: its first row's size says what is text. */
+STATIC VOID DrawLabel(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, EFI_HII_FONT_PROTOCOL *Font, CONST CHAR16 *Text,
+                      UINTN CentreX, UINTN Top, UINTN Zoom)
+{
+    EFI_FONT_DISPLAY_INFO *Info;
+    EFI_IMAGE_OUTPUT *Image = NULL;
+    EFI_HII_ROW_INFO *Rows = NULL;
+    UINTN RowCount = 0;
+
+    if (Font == NULL)
+        return;
+    Info = AllocateZeroPool(sizeof(EFI_FONT_DISPLAY_INFO) + sizeof(CHAR16) * 2);
+    if (Info == NULL)
+        return;
+    Info->ForegroundColor = kText;
+    Info->BackgroundColor = kBlack;
+    Info->FontInfoMask = EFI_FONT_INFO_SYS_FONT | EFI_FONT_INFO_SYS_SIZE | EFI_FONT_INFO_SYS_STYLE;
+    EFI_STATUS Status = Font->StringToImage(Font, EFI_HII_IGNORE_LINE_BREAK, (EFI_STRING)Text, Info, &Image, 0, 0,
+                                            &Rows, &RowCount, NULL);
+    if (!EFI_ERROR(Status) && Image != NULL && Rows != NULL && RowCount > 0) {
+        UINTN TextW = MIN(Rows[0].LineWidth, Image->Width), TextH = MIN(Rows[0].LineHeight, Image->Height);
+        UINTN W = TextW * Zoom, H = TextH * Zoom;
+        EFI_GRAPHICS_OUTPUT_BLT_PIXEL *Out = W && H ? AllocatePool(W * H * sizeof(*Out)) : NULL;
+        if (Out != NULL) {
+            for (UINTN y = 0; y < H; y++)
+                for (UINTN x = 0; x < W; x++)
+                    Out[y * W + x] = Image->Image.Bitmap[(y / Zoom) * Image->Width + x / Zoom];
+            UINTN Left = CentreX > W / 2 ? CentreX - W / 2 : 0;
+            GOP->Blt(GOP, Out, EfiBltBufferToVideo, 0, 0, Left, Top, W, H, 0);
+            FreePool(Out);
+        }
+    }
+    if (Image != NULL) {
+        if (Image->Image.Bitmap != NULL)
+            FreePool(Image->Image.Bitmap);
+        FreePool(Image);
+    }
+    if (Rows != NULL)
+        FreePool(Rows);
+    FreePool(Info);
+}
+
+/*
+ * The whole picker. Focus: 0 the entries (Chosen is the one), 1 the restart
+ * button, 2 the shut down button.
+ */
+STATIC VOID DrawGraphical(EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP, EFI_HII_FONT_PROTOCOL *Font, PICKER_ENTRY *Entries,
+                          UINTN N, UINTN Chosen, UINTN Focus)
+{
+    UINTN W = GOP->Mode->Info->HorizontalResolution, H = GOP->Mode->Info->VerticalResolution;
+    UINTN Icon = Scale(ICON_SIZE, H), Gap = Scale(ICON_GAP, H), Pad = Scale(HIGHLIGHT_PAD, H);
+    UINTN Zoom = H >= 1800 ? 2 : 1;
+
+    /* Narrower when they do not fit across. */
+    while (N * Icon + (N - 1) * Gap + 2 * Pad > W * 9 / 10 && Icon > 48) {
+        Icon = Icon * 9 / 10;
+        Gap = Gap * 9 / 10;
+    }
+    UINTN RowWidth = N * Icon + (N - 1) * Gap;
+    UINTN Left = (W - RowWidth) / 2, Top = Scale(ROW_CENTRE_Y, H) - Icon / 2;
+    UINTN LabelTop = Top + Icon + Pad + Scale(LABEL_GAP, H) / 2;
+
+    GOP->Blt(GOP, (EFI_GRAPHICS_OUTPUT_BLT_PIXEL *)&kBlack, EfiBltVideoFill, 0, 0, 0, 0, W, H, 0);
+    for (UINTN i = 0; i < N; i++) {
+        UINTN x = Left + i * (Icon + Gap);
+        BOOLEAN Lit = (i == Chosen && Focus == 0);
+        if (Lit)
+            DrawHighlight(GOP, x - Pad, Top - Pad, Icon + 2 * Pad, Icon + 2 * Pad, Scale(18, H), &kHighlight);
+        DrawIcon(GOP, &gIcons[Entries[i].Icon], x, Top, Icon, Lit ? &kHighlight : &kBlack);
+        DrawLabel(GOP, Font, Entries[i].Name, x + Icon / 2, LabelTop, Zoom);
+    }
+    /* The start button, under the chosen entry's name. */
+    UINTN Start = Scale(START_SIZE, H);
+    UINTN cx = Left + Chosen * (Icon + Gap) + Icon / 2;
+    DrawIcon(GOP, &gIcons[IconStart], cx - Start / 2, LabelTop + Scale(46, H) * Zoom, Start, &kBlack);
+
+    /* Restart and shut down, at the bottom. */
+    UINTN Button = Scale(BUTTON_SIZE, H), BGap = Scale(BUTTON_GAP, H), By = Scale(BUTTONS_Y, H);
+    UINTN Bx = (W - 2 * Button - BGap) / 2;
+    for (UINTN b = 0; b < 2; b++) {
+        UINTN x = Bx + b * (Button + BGap);
+        BOOLEAN Lit = (Focus == b + 1);
+        if (Lit)
+            DrawHighlight(GOP, x - Pad / 2, By - Pad / 2, Button + Pad, Button + Pad, (Button + Pad) / 2, &kHighlight);
+        DrawIcon(GOP, &gIcons[b == 0 ? IconRestart : IconShutdown], x, By, Button, Lit ? &kHighlight : &kBlack);
+    }
+}
+
+STATIC VOID DrawText(PICKER_ENTRY *Entries, UINTN N, UINTN Chosen)
+{
+    EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *Out = gST->ConOut;
+    UINTN Columns = 80, Rows = 25;
+
+    Out->QueryMode(Out, Out->Mode->Mode, &Columns, &Rows);
+    Out->SetAttribute(Out, EFI_TEXT_ATTR(EFI_LIGHTGRAY, EFI_BLACK));
+    Out->ClearScreen(Out);
+    Out->EnableCursor(Out, FALSE);
+    UINTN Width = 40, Left = Columns > Width ? (Columns - Width) / 2 : 0;
+    UINTN Top = Rows > N + 6 ? (Rows - N - 6) / 2 : 0;
+    Out->SetCursorPosition(Out, Left, Top);
+    Out->OutputString(Out, UEFI_STR("Choose a startup disk"));
+    for (UINTN i = 0; i < N; i++) {
+        CHAR16 Line[64];
+        UnicodeSPrint(Line, sizeof(Line), UEFI_STR(" %-38s "), Entries[i].Name);
+        Out->SetCursorPosition(Out, Left, Top + 2 + i);
+        Out->SetAttribute(Out, i == Chosen ? EFI_TEXT_ATTR(EFI_BLACK, EFI_LIGHTGRAY)
+                                           : EFI_TEXT_ATTR(EFI_LIGHTGRAY, EFI_BLACK));
+        Out->OutputString(Out, Line);
+    }
+    Out->SetAttribute(Out, EFI_TEXT_ATTR(EFI_DARKGRAY, EFI_BLACK));
+    Out->SetCursorPosition(Out, Left, Top + 3 + N);
+    Out->OutputString(Out, UEFI_STR("Up and down to choose, Return to start"));
+    Out->SetAttribute(Out, EFI_TEXT_ATTR(EFI_LIGHTGRAY, EFI_BLACK));
+}
+
+/* Another volume's loader started; back here if it returns. */
+STATIC VOID StartOther(EFI_HANDLE ImageHandle, PICKER_ENTRY *E)
+{
+    EFI_DEVICE_PATH_PROTOCOL *Path = FileDevicePath(E->Volume, E->Path);
+    EFI_HANDLE Image = NULL;
+
+    if (Path == NULL)
+        return;
+    if (!EFI_ERROR(gBS->LoadImage(FALSE, ImageHandle, Path, NULL, 0, &Image))) {
+        gST->ConOut->ClearScreen(gST->ConOut);
+        gBS->StartImage(Image, NULL, NULL);
+    }
+    FreePool(Path);
+}
+
+BOOT_KEYS RunPicker(EFI_HANDLE ImageHandle)
+{
+    PICKER_ENTRY Entries[MAX_ENTRIES];
+    EFI_GRAPHICS_OUTPUT_PROTOCOL *GOP = NULL;
+    EFI_HII_FONT_PROTOCOL *Font = NULL;
+    UINTN Chosen = 0, Focus = 0;
+
+    ZeroMem(Entries, sizeof(Entries));
+    UINTN N = FindEntries(ImageHandle, Entries);
+    BOOLEAN Graphical = LoadIcons() &&
+        !EFI_ERROR(gBS->HandleProtocol(gST->ConsoleOutHandle, &gEfiGraphicsOutputProtocolGuid, (VOID **)&GOP));
+    if (Graphical)
+        gBS->LocateProtocol(&gEfiHiiFontProtocolGuid, NULL, (VOID **)&Font);
+    Print(UEFI_STR("[] Boot picker: %u entries, %a%a\n"), N, Graphical ? "graphical" : "text",
+          Graphical && Font == NULL ? " (no font)" : "");
+    if (Graphical)
+        gST->ConOut->EnableCursor(gST->ConOut, FALSE);
+
+    for (;;) {
+        EFI_INPUT_KEY Key;
+        UINTN Index;
+        if (Graphical)
+            DrawGraphical(GOP, Font, Entries, N, Chosen, Focus);
+        else
+            DrawText(Entries, N, Chosen);
+        gBS->WaitForEvent(1, &gST->ConIn->WaitForKey, &Index);
+        if (EFI_ERROR(gST->ConIn->ReadKeyStroke(gST->ConIn, &Key)))
+            continue;
+        BOOLEAN Back = Graphical ? Key.ScanCode == SCAN_LEFT : Key.ScanCode == SCAN_UP;
+        BOOLEAN Next = Graphical ? Key.ScanCode == SCAN_RIGHT : Key.ScanCode == SCAN_DOWN;
+        if (Focus == 0 && Back && Chosen > 0)
+            Chosen--;
+        else if (Focus == 0 && Next && Chosen + 1 < N)
+            Chosen++;
+        else if (Graphical && Focus > 0 && (Key.ScanCode == SCAN_LEFT || Key.ScanCode == SCAN_RIGHT))
+            Focus = Key.ScanCode == SCAN_LEFT ? 1 : 2;
+        else if (Graphical && Key.ScanCode == SCAN_DOWN && Focus == 0)
+            Focus = 1;
+        else if (Graphical && Key.ScanCode == SCAN_UP && Focus > 0)
+            Focus = 0;
+        else if (Key.ScanCode == SCAN_ESC) {
+            Chosen = 0;
+            break;
+        } else if (Key.UnicodeChar == CHAR_CARRIAGE_RETURN) {
+            if (Focus == 1)
+                gRT->ResetSystem(EfiResetCold, EFI_SUCCESS, 0, NULL);
+            if (Focus == 2)
+                gRT->ResetSystem(EfiResetShutdown, EFI_SUCCESS, 0, NULL);
+            if (Entries[Chosen].Volume == NULL)
+                break;
+            StartOther(ImageHandle, &Entries[Chosen]);
+        }
+    }
+    FreeIcons();
+    gST->ConOut->ClearScreen(gST->ConOut);
+    Print(UEFI_STR("[] Boot picker: %s\n"), Entries[Chosen].Name);
+    return Entries[Chosen].Volume == NULL ? Entries[Chosen].Keys : BootKeysNone;
+}
