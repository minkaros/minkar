+/* Minkar */
+STATIC CONST CHAR16 *MemoryTypeName(UINT32 Type)
+{
+    STATIC CONST CHAR16 *Names[] = {
+        UEFI_STR("Reserved"), UEFI_STR("LoaderCode"), UEFI_STR("LoaderData"),
+        UEFI_STR("BootServicesCode"), UEFI_STR("BootServicesData"),
+        UEFI_STR("RuntimeServicesCode"), UEFI_STR("RuntimeServicesData"),
+        UEFI_STR("Conventional"), UEFI_STR("Unusable"), UEFI_STR("ACPIReclaim"),
+        UEFI_STR("ACPINVS"), UEFI_STR("MMIO"), UEFI_STR("MMIOPort"),
+        UEFI_STR("PalCode"), UEFI_STR("Persistent"),
+    };
+    return Type < ARRAY_SIZE(Names) ? Names[Type] : UEFI_STR("Other");
+}
+
+/*
+ * Minkar: where the kernel goes. It is linked to run at 1 MB physical, and
+ * firmware keeps its own code and data there while boot services run (QEMU:
+ * BootServicesData from 9 MB, ACPI NVS at 8 MB; the H270N reset when the
+ * loader wrote over it). The kernel, the device tree, the boot args and
+ * the EFI tables are therefore laid out in a staging buffer allocated from
+ * the firmware, and moved to their place after ExitBootServices(), when
+ * boot-services memory is free (as GRUB's relocator does for xnu).
+ *
+ * gStageDelta is the staging buffer's address minus the final address:
+ * STAGED(x) is where the loader writes what the kernel will find at x.
+ */
+INTN gStageDelta;
+UINT64 gKernelTarget, gKernelTargetSize;
+
+/*
+ * Firmware memory the kernel may take once boot services are gone. ACPI NVS
+ * is kept by the firmware across sleep states and is reported, but QEMU's
+ * firmware has some at 8 MB and the kernel has always been loaded over it.
+ */
+STATIC BOOLEAN FreeAfterExit(UINT32 Type)
+{
+    return Type == EfiConventionalMemory || Type == EfiLoaderCode ||
+           Type == EfiLoaderData || Type == EfiBootServicesCode ||
+           Type == EfiBootServicesData;
+}
+
+EFI_STATUS PrepareKernelRange(struct mach_header_64 *mh, UINTN TailBytes, UINT64 *ReservedEnd)
+{
+    UINT64 lo = KERNEL_LOAD_ADDRESS, hi = 0;
+    UINT32 offset = sizeof(struct mach_header_64);
+
+    for(UINT32 i = 0; i < mh->ncmds; ++i) {
+        const struct load_command *lc = (const struct load_command *)((UINT64)mh + offset);
+        if(lc->cmd == LC_SEGMENT_64) {
+            const struct segment_command_64 *ls = (const struct segment_command_64 *)lc;
+            if(ls->vmsize != 0) {
+                UINT64 start = PHYSADDR(ls->vmaddr);
+                if(start < lo)
+                    lo = start;
+                if(start + ls->vmsize > hi)
+                    hi = start + ls->vmsize;
+            }
+        }
+        offset += lc->cmdsize;
+    }
+    if(lo != KERNEL_LOAD_ADDRESS || hi <= lo) {
+        Print(UEFI_STR("!! Error: kernel segments at 0x%lx-0x%lx, not from 0x%x\n"),
+            lo, hi, KERNEL_LOAD_ADDRESS);
+        return EFI_LOAD_ERROR;
+    }
+    hi = ((hi + EFI_PAGE_MASK) & ~(UINT64)EFI_PAGE_MASK) + TailBytes;
+
+    /* Look at what the firmware has in the range now. */
+    UINTN Size = 0, Key, DescSize;
+    UINT32 DescVersion;
+    EFI_MEMORY_DESCRIPTOR *Map = NULL;
+    EFI_STATUS Status = gBS->GetMemoryMap(&Size, NULL, &Key, &DescSize, &DescVersion);
+    if(Status != EFI_BUFFER_TOO_SMALL)
+        return EFI_ERROR(Status) ? Status : EFI_LOAD_ERROR;
+    Size += 8 * DescSize;
+    Status = gBS->AllocatePool(EfiLoaderData, Size, (VOID **)&Map);
+    if(EFI_ERROR(Status))
+        return Status;
+    Status = gBS->GetMemoryMap(&Size, Map, &Key, &DescSize, &DescVersion);
+    if(EFI_ERROR(Status)) {
+        gBS->FreePool(Map);
+        return Status;
+    }
+
+    UINT64 covered = 0;
+    BOOLEAN blocked = FALSE;
+    for(UINT8 *p = (UINT8 *)Map; p < (UINT8 *)Map + Size; p += DescSize) {
+        EFI_MEMORY_DESCRIPTOR *d = (EFI_MEMORY_DESCRIPTOR *)p;
+        UINT64 dStart = d->PhysicalStart;
+        UINT64 dEnd = dStart + EFI_PAGES_TO_SIZE(d->NumberOfPages);
+        if(dEnd <= lo || dStart >= hi)
+            continue;
+        UINT64 s = dStart > lo ? dStart : lo, e = dEnd < hi ? dEnd : hi;
+        covered += e - s;
+        if(FreeAfterExit(d->Type))
+            continue;
+        Print(UEFI_STR("   0x%08lx-0x%08lx %s%a\n"), s, e, MemoryTypeName(d->Type),
+            d->Type == EfiACPIMemoryNVS ? " (overwritten)" : "");
+        if(d->Type != EfiACPIMemoryNVS)
+            blocked = TRUE;
+    }
+    gBS->FreePool(Map);
+    if(blocked || covered != hi - lo) {
+        Print(UEFI_STR("!! Error: the firmware keeps memory the kernel needs (0x%lx-0x%lx)\n"), lo, hi);
+        return EFI_ACCESS_DENIED;
+    }
+
+    /*
+     * Take the free pages of the range, so that nothing the loader allocates
+     * from here on (the staging buffer, the memory map) lands in it.
+     */
+    Status = gBS->GetMemoryMap(&Size, NULL, &Key, &DescSize, &DescVersion);
+    Size += 16 * DescSize;
+    if(EFI_ERROR(gBS->AllocatePool(EfiLoaderData, Size, (VOID **)&Map)))
+        return EFI_OUT_OF_RESOURCES;
+    Status = gBS->GetMemoryMap(&Size, Map, &Key, &DescSize, &DescVersion);
+    for(UINT8 *p = (UINT8 *)Map; !EFI_ERROR(Status) && p < (UINT8 *)Map + Size; p += DescSize) {
+        EFI_MEMORY_DESCRIPTOR *d = (EFI_MEMORY_DESCRIPTOR *)p;
+        UINT64 dEnd = d->PhysicalStart + EFI_PAGES_TO_SIZE(d->NumberOfPages);
+        if(d->Type != EfiConventionalMemory || dEnd <= lo || d->PhysicalStart >= hi)
+            continue;
+        EFI_PHYSICAL_ADDRESS s = d->PhysicalStart > lo ? d->PhysicalStart : lo;
+        UINT64 e = dEnd < hi ? dEnd : hi;
+        gBS->AllocatePages(AllocateAddress, EfiLoaderData, EFI_SIZE_TO_PAGES(e - s), &s);
+    }
+    gBS->FreePool(Map);
+
+    EFI_PHYSICAL_ADDRESS staging;
+    Status = gBS->AllocatePages(AllocateAnyPages, EfiLoaderData, EFI_SIZE_TO_PAGES(hi - lo), &staging);
+    if(EFI_ERROR(Status)) {
+        Print(UEFI_STR("!! Error: no memory to stage the kernel: %r\n"), Status);
+        return Status;
+    }
+    SetMem((VOID *)(UINTN)staging, hi - lo, 0);
+    gStageDelta = (INTN)(staging - lo);
+    gKernelTarget = lo;
+    gKernelTargetSize = hi - lo;
+    *ReservedEnd = hi;
+    Print(UEFI_STR("    Kernel 0x%lx-0x%lx, staged at 0x%lx\n"), lo, hi, staging);
+    return EFI_SUCCESS;
+}
+
+/*
+ * TRUE if [Start, Start+Length) meets the kernel's final range. Used to make
+ * sure what is still needed after ExitBootServices() (the loader, its stack,
+ * the page tables, the GDT, the memory map) is not overwritten by the move.
+ */
+BOOLEAN InKernelRange(UINT64 Start, UINT64 Length)
+{
+    return Start < gKernelTarget + gKernelTargetSize && Start + Length > gKernelTarget;
+}
