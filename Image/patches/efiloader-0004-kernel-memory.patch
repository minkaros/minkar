+/* Minkar: leave the reason on the screen before the firmware takes over. */
+STATIC EFI_STATUS LoaderFail(CONST CHAR16 *What, EFI_STATUS Status)
+{
+    Print(UEFI_STR("!! Error: %s: %r\n"), What, Status);
+    gBS->Stall(15 * 1000 * 1000);
+    return Status;
+}
+
+/*
+ * Minkar: what the loader still uses after ExitBootServices() must not be in
+ * the kernel's final range, which is overwritten then: the loader itself,
+ * its stack, the page tables the CPU walks, and the GDT.
+ */
+STATIC EFI_STATUS CheckMoveIsSafe(EFI_HANDLE ImageHandle)
+{
+    EFI_LOADED_IMAGE_PROTOCOL *Image;
+    BOOLEAN Safe = TRUE;
+    UINT64 Rsp, Cr3;
+    struct { UINT16 Limit; UINT64 Base; } __attribute__((packed)) Gdt;
+
+    if (!EFI_ERROR(gBS->HandleProtocol(ImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Image)) &&
+        InKernelRange((UINTN)Image->ImageBase, Image->ImageSize)) {
+        Print(UEFI_STR("!! The loader is at 0x%p\n"), Image->ImageBase);
+        Safe = FALSE;
+    }
+    asm volatile("movq %%rsp, %0" : "=r"(Rsp));
+    if (InKernelRange(Rsp - SIZE_64KB, SIZE_64KB + SIZE_4KB)) {
+        Print(UEFI_STR("!! The stack is at 0x%lx\n"), Rsp);
+        Safe = FALSE;
+    }
+    asm volatile("sgdt %0" : "=m"(Gdt));
+    if (InKernelRange(Gdt.Base, (UINT64)Gdt.Limit + 1)) {
+        Print(UEFI_STR("!! The GDT is at 0x%lx\n"), Gdt.Base);
+        Safe = FALSE;
+    }
+
+    /* The page tables: every table page reachable from CR3 (4-level paging). */
+    asm volatile("movq %%cr3, %0" : "=r"(Cr3));
+    CONST UINT64 Addr = 0x000FFFFFFFFFF000ULL, Present = 1, Large = 1 << 7;
+    UINT64 *Pml4 = (UINT64 *)(UINTN)(Cr3 & Addr);
+    UINTN Hits = 0;
+    Hits += InKernelRange((UINTN)Pml4, SIZE_4KB);
+    for (UINTN i = 0; i < 512; ++i) {
+        if (!(Pml4[i] & Present))
+            continue;
+        UINT64 *Pdpt = (UINT64 *)(UINTN)(Pml4[i] & Addr);
+        Hits += InKernelRange((UINTN)Pdpt, SIZE_4KB);
+        for (UINTN j = 0; j < 512; ++j) {
+            if (!(Pdpt[j] & Present) || (Pdpt[j] & Large))
+                continue;
+            UINT64 *Pd = (UINT64 *)(UINTN)(Pdpt[j] & Addr);
+            Hits += InKernelRange((UINTN)Pd, SIZE_4KB);
+            for (UINTN k = 0; k < 512; ++k)
+                if ((Pd[k] & Present) && !(Pd[k] & Large))
+                    Hits += InKernelRange(Pd[k] & Addr, SIZE_4KB);
+        }
+    }
+    if (Hits != 0) {
+        Print(UEFI_STR("!! %u page-table pages are in the kernel's range\n"), Hits);
+        Safe = FALSE;
+    }
+    return Safe ? EFI_SUCCESS : EFI_ACCESS_DENIED;
+}
+
+/*
+ * Minkar: after ExitBootServices() nothing can print, so with loader-pause
+ * set (a hardware test) the loader paints white band N, 20 pixels high, at
+ * the top of the screen as it passes each step: the number of bands on a
+ * photo of a machine that reset says how far it got.
+ */
+STATIC VOID Stripe(UINTN N)
+{
+    if (gFbBase == 0 || gBootConfig.LoaderPause == 0)
+        return;
+    UINT32 *Fb = (UINT32 *)(UINTN)gFbBase;
+    for (UINTN y = N * 24; y < N * 24 + 20 && y < gFbHeight; ++y)
+        for (UINTN x = 0; x < gFbWidth; ++x)
+            Fb[y * gFbStride + x] = 0x00FFFFFF;
+}
+
+/*
+ * Minkar: page tables mapping physical memory 1:1, writable and executable,
+ * with 2 MB pages, for the move after ExitBootServices(). A PC firmware's
+ * own tables may keep its former memory read-only or no-execute; these do
+ * not. They cover the memory map and the framebuffer, up to 512 GB.
+ */
+STATIC EFI_STATUS BuildIdentityMap(UINT64 *Cr3)
+{
+    UINTN Size = 0, Key, DescSize;
+    UINT32 DescVersion;
+    EFI_MEMORY_DESCRIPTOR *Map = NULL;
+    UINT64 Top = SIZE_4GB;
+    EFI_STATUS Status;
+
+    Status = gBS->GetMemoryMap(&Size, NULL, &Key, &DescSize, &DescVersion);
+    if (Status != EFI_BUFFER_TOO_SMALL)
+        return EFI_ERROR(Status) ? Status : EFI_LOAD_ERROR;
+    Size += 8 * DescSize;
+    Status = gBS->AllocatePool(EfiLoaderData, Size, (VOID **)&Map);
+    if (EFI_ERROR(Status))
+        return Status;
+    Status = gBS->GetMemoryMap(&Size, Map, &Key, &DescSize, &DescVersion);
+    for (UINT8 *p = (UINT8 *)Map; !EFI_ERROR(Status) && p < (UINT8 *)Map + Size; p += DescSize) {
+        EFI_MEMORY_DESCRIPTOR *d = (EFI_MEMORY_DESCRIPTOR *)p;
+        UINT64 End = d->PhysicalStart + EFI_PAGES_TO_SIZE(d->NumberOfPages);
+        if (End > Top)
+            Top = End;
+    }
+    gBS->FreePool(Map);
+    if (EFI_ERROR(Status))
+        return Status;
+    if (gFbBase + gFbSize > Top)
+        Top = gFbBase + gFbSize;
+    Top = (Top + SIZE_1GB - 1) & ~(UINT64)(SIZE_1GB - 1);
+    if (Top > SIZE_512GB)
+        Top = SIZE_512GB;
+
+    UINTN Gigs = (UINTN)(Top / SIZE_1GB);
+    EFI_PHYSICAL_ADDRESS Tables = 0xFFFFFFFF;
+    Status = gBS->AllocatePages(AllocateMaxAddress, EfiLoaderData, 2 + Gigs, &Tables);
+    if (EFI_ERROR(Status))
+        return Status;
+    SetMem((VOID *)(UINTN)Tables, EFI_PAGES_TO_SIZE(2 + Gigs), 0);
+
+    UINT64 *Pml4 = (UINT64 *)(UINTN)Tables;
+    UINT64 *Pdpt = Pml4 + 512;
+    UINT64 *Pd = Pdpt + 512;
+    CONST UINT64 Present = 1, Write = 2, Large = 0x80;
+    Pml4[0] = (UINT64)(UINTN)Pdpt | Present | Write;
+    for (UINTN g = 0; g < Gigs; ++g) {
+        Pdpt[g] = (UINT64)(UINTN)(Pd + g * 512) | Present | Write;
+        for (UINTN i = 0; i < 512; ++i)
+            Pd[g * 512 + i] = ((UINT64)g * SIZE_1GB + (UINT64)i * SIZE_2MB) | Present | Write | Large;
+    }
+    *Cr3 = Tables;
+    return EFI_SUCCESS;
+}
+
+/*
+ * Minkar: what the kernel's start code expects of the CPU. xnu's 32-bit
+ * entry set EFER.NXE and CR0.WP itself; the 64-bit entry from this loader
+ * takes the CPU as the firmware left it. OVMF sets NXE; a PC firmware may
+ * not, and the kernel's first page table with a no-execute bit then faults
+ * before the kernel has any handler: the machine resets.
+ */
+STATIC VOID PrepareCpuForKernel(VOID)
+{
+    UINT32 a, b, c, d;
+    UINT64 Cr0;
+
+    asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(0x80000000), "c"(0));
+    if (a >= 0x80000001) {
+        asm volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(0x80000001), "c"(0));
+        if (d & (1U << 20)) {   /* NX */
+            UINT32 Lo, Hi;
+            asm volatile("rdmsr" : "=a"(Lo), "=d"(Hi) : "c"(0xC0000080));
+            Lo |= 1U << 11;     /* EFER.NXE */
+            asm volatile("wrmsr" : : "a"(Lo), "d"(Hi), "c"(0xC0000080));
+        }
+    }
+    asm volatile("movq %%cr0, %0" : "=r"(Cr0));
+    Cr0 |= 1ULL << 16;          /* CR0.WP */
+    asm volatile("movq %0, %%cr0" : : "r"(Cr0));
+}
+
+/* Minkar: the CPU state the firmware leaves, for a photo of a failing PC. */
+STATIC VOID PrintCpuState(VOID)
+{
+    UINT32 Lo, Hi;
+    UINT64 Cr0, Cr4;
+
+    asm volatile("rdmsr" : "=a"(Lo), "=d"(Hi) : "c"(0xC0000080));
+    asm volatile("movq %%cr0, %0" : "=r"(Cr0));
+    asm volatile("movq %%cr4, %0" : "=r"(Cr4));
+    Print(UEFI_STR("[] CPU: EFER 0x%x CR0 0x%lx CR4 0x%lx\n"), Lo, Cr0, Cr4);
+}
+
+/*
+ * Minkar: take the final memory map and leave boot services. The map has to
+ * be taken after the loader's last allocation, or ExitBootServices() rejects
+ * its key and the kernel starts with the firmware still running; the
+ * firmware may also change the map during the call, and then the map is
+ * taken again (UEFI 2.10, section 7.4). It is written to the staging
+ * buffer and reaches MapFinal with the kernel.
+ */
+STATIC EFI_STATUS ExitFirmware(EFI_HANDLE ImageHandle, BOOT_ARGS *BootArgs, VOID *MapFinal)
+{
+    UINTN Size = 0, Key, DescSize;
+    UINT32 DescVersion;
+    EFI_STATUS Status = EFI_LOAD_ERROR;
+
+    for (int Try = 0; Try < 8; ++Try) {
+        Size = EFI_PAGES_TO_SIZE(MMAP_PAGES);
+        Status = gBS->GetMemoryMap(&Size, (EFI_MEMORY_DESCRIPTOR *)STAGED(MapFinal),
+                                   &Key, &DescSize, &DescVersion);
+        if (EFI_ERROR(Status))
+            return Status;
+        Status = gBS->ExitBootServices(ImageHandle, Key);
+        if (!EFI_ERROR(Status))
+            break;
+    }
+    if (EFI_ERROR(Status))
+        return Status;
+
+    /*
+     * The kernel's efi_init() maps each runtime region at its VirtualStart
+     * (or'ed with the kernel's base), and panics where it has no page
+     * tables yet. The loader does not call SetVirtualAddressMap(), the
+     * firmware reports VirtualStart 0, and every region then landed on the
+     * kernel's own boot code. The map used to be at 0x10000, which the
+     * kernel had reused by then, so efi_init() never mapped anything; the
+     * kernel's copy now says so explicitly. The regions stay out of the
+     * kernel's free memory by their type, and the runtime services are
+     * still called at their physical addresses (EFINVRAM).
+     */
+    for (UINT8 *d = STAGED(MapFinal); d < (UINT8 *)STAGED(MapFinal) + Size; d += DescSize)
+        ((EFI_MEMORY_DESCRIPTOR *)d)->Attribute &= ~EFI_MEMORY_RUNTIME;
+
+    BootArgs->MemoryMap = PHYSADDR(MapFinal);
+    BootArgs->MemoryMapSize = (UINT32)Size;
+    BootArgs->MemoryMapDescriptorSize = (UINT32)DescSize;
+    BootArgs->MemoryMapDescriptorVersion = DescVersion;
+    return EFI_SUCCESS;
+}
