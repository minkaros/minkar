  */
+EFI_STATUS OpenBootVolume(EFI_FILE_HANDLE *Root);
+
+/* Minkar: the log, written over the last boot's. */
+STATIC VOID SaveLog(VOID)
+{
+    EFI_FILE_HANDLE Root, File;
+    CHAR16 *Name = UEFI_STR("\\Minkar\\loader.log");
+    UINTN Size = gLogLength;
+
+    if (EFI_ERROR(OpenBootVolume(&Root)))
+        return;
+    if (!EFI_ERROR(Root->Open(Root, &File, Name, EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0)))
+        File->Delete(File);
+    if (!EFI_ERROR(Root->Open(Root, &File, Name,
+            EFI_FILE_MODE_CREATE | EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0))) {
+        File->Write(File, &Size, gLog);
+        File->Close(File);
+    }
+    Root->Close(Root);
+}
