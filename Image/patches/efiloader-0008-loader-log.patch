+
+/*
+ * Minkar: everything the loader prints is kept and written to
+ * \Minkar\loader.log on its own volume before the kernel starts. Some
+ * firmware (a Mac Pro's) never shows the loader's text on the screen;
+ * the log says which graphics mode was chosen and what the kernel got.
+ */
+STATIC CHAR8 gLog[16384];
+STATIC UINTN gLogLength;
+
+STATIC UINTN EFIAPI LogPrint(IN CONST CHAR16 *Format, ...)
+{
+    VA_LIST Args;
+    CHAR16 Line[512];
+    UINTN Length;
+
+    VA_START(Args, Format);
+    Length = UnicodeVSPrint(Line, sizeof(Line), Format, Args);
+    VA_END(Args);
+    Print(UEFI_STR("%s"), Line);
+    for (UINTN i = 0; Line[i] != 0 && gLogLength < sizeof(gLog) - 1; i++)
+        gLog[gLogLength++] = (Line[i] < 0x80) ? (CHAR8)Line[i] : '?';
+    return Length;
+}
+#define Print LogPrint
 /*
  * Minkar: room reserved after the kernel for the device tree, the boot
  * arguments and the copied EFI tables (see the layout in loader.h).
