+/*
+ * Minkar: entropy from the CPU's RDRAND instruction, for firmware without
+ * EFI_RNG_PROTOCOL. FALSE when the CPU has no RDRAND or it keeps failing.
+ */
+static BOOLEAN CpuEntropy(UINT8 *buf, UINTN len)
+{
+    UINT32 eax, ebx, ecx, edx;
+    UINT64 v;
+    UINTN i, n;
+    UINT8 ok;
+    int tries;
+
+    __asm__ volatile("cpuid" : "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx) : "a"(1), "c"(0));
+    if(!(ecx & (1U << 30)))
+        return FALSE;
+    for(i = 0; i < len; i += sizeof(v)) {
+        ok = 0;
+        for(tries = 0; tries < 10 && !ok; ++tries)
+            __asm__ volatile("rdrand %0; setc %1" : "=r"(v), "=qm"(ok));
+        if(!ok)
+            return FALSE;
+        n = len - i < sizeof(v) ? len - i : sizeof(v);
+        CopyMem(buf + i, &v, n);
+    }
+    return TRUE;
+}
