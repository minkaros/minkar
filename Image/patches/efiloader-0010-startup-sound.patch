+/*
+ * Minkar: the firmware's startup sound, from "startup-sound" in the boot
+ * plist ("off" or "on"). Some machines' firmware plays it at power-on with
+ * the volume in the 1-byte NVRAM variable SystemAudioVolume (the firmware
+ * vendor's GUID below); bit 7 set mutes it. The change takes effect at the
+ * next power-on, and is written only when it differs.
+ */
+STATIC EFI_GUID gStartupSoundGuid =
+    { 0x7C436110, 0xAB2A, 0x4BBB, { 0xA8, 0x80, 0xFE, 0x41, 0x99, 0x5C, 0x9F, 0x82 } };
+#define STARTUP_SOUND_MUTED	0x80
+
+STATIC VOID SetStartupSound(VOID)
+{
+    CONST CHAR8 *want = gBootConfig.StartupSound;
+    BOOLEAN off;
+    UINT8 volume = 0;
+    UINTN size = sizeof(volume);
+    UINT32 attributes = EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS |
+        EFI_VARIABLE_RUNTIME_ACCESS;
+
+    if (AsciiStrCmp(want, "off") == 0)
+        off = TRUE;
+    else if (AsciiStrCmp(want, "on") == 0)
+        off = FALSE;
+    else
+        return;
+    EFI_STATUS st = gST->RuntimeServices->GetVariable(UEFI_STR("SystemAudioVolume"), &gStartupSoundGuid,
+                                     &attributes, &size, &volume);
+    if (EFI_ERROR(st)) {
+        if (!off)
+            return;		/* no variable: nothing to turn back on */
+        volume = 0;
+        attributes = EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS |
+            EFI_VARIABLE_RUNTIME_ACCESS;
+    }
+    UINT8 next = off ? (UINT8)(volume | STARTUP_SOUND_MUTED) : (UINT8)(volume & ~STARTUP_SOUND_MUTED);
+    if (!EFI_ERROR(st) && next == volume) {
+        Print(UEFI_STR("[] Startup sound: %a (0x%02x)\n"), off ? "off" : "on", volume);
+        return;
+    }
+    st = gST->RuntimeServices->SetVariable(UEFI_STR("SystemAudioVolume"), &gStartupSoundGuid, attributes,
+                          sizeof(next), &next);
+    Print(UEFI_STR("[] Startup sound: %a (0x%02x -> 0x%02x): %r\n"), off ? "off" : "on",
+          volume, next, st);
+}
