libepoxy on Minkar: Darwin with EGL (Mesa's libEGL and libGLESv2 in /usr/lib),
so the EGL dispatch is built and loads them by their paths.

--- a/src/dispatch_common.c
+++ b/src/dispatch_common.c
@@ -173,7 +173,14 @@
 
 #include "dispatch_common.h"
 
-#if defined(__APPLE__)
+#if defined(__MINKAR__)
+/* Mesa's EGL and OpenGL ES in /usr/lib; desktop OpenGL is the framework's. */
+#define GLX_LIB "/usr/lib/libGL.1.dylib"
+#define EGL_LIB "/usr/lib/libEGL.1.dylib"
+#define GLES1_LIB "/usr/lib/libGLESv1_CM.1.dylib"
+#define GLES2_LIB "/usr/lib/libGLESv2.2.dylib"
+#define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/A/OpenGL"
+#elif defined(__APPLE__)
 #define GLX_LIB "/opt/X11/lib/libGL.1.dylib"
 #define OPENGL_LIB "/System/Library/Frameworks/OpenGL.framework/Versions/Current/OpenGL"
 #define GLES1_LIB "libGLESv1_CM.so"
--- a/src/dispatch_common.h
+++ b/src/dispatch_common.h
@@ -27,7 +27,7 @@
 #define PLATFORM_HAS_EGL ENABLE_EGL
 #define PLATFORM_HAS_GLX ENABLE_GLX
 #define PLATFORM_HAS_WGL 1
-#elif defined(__APPLE__)
+#elif defined(__APPLE__) && !defined(__MINKAR__)
 #define PLATFORM_HAS_EGL 0 
 #define PLATFORM_HAS_GLX ENABLE_GLX
 #define PLATFORM_HAS_WGL 0
