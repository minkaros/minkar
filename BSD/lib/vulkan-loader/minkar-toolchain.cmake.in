# CMake's toolchain file for Minkar (x86-64), for projects built with CMake
# on the build host: the toolchain's clang and ld64 against the SDK.
# @TC@ and @SDK@ are set by the Makefile.

set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_OSX_ARCHITECTURES x86_64)
set(CMAKE_OSX_DEPLOYMENT_TARGET 10.15)
set(CMAKE_OSX_SYSROOT @SDK@)
set(CMAKE_SYSROOT @SDK@)

set(CMAKE_C_COMPILER @TC@/clang)
set(CMAKE_CXX_COMPILER @TC@/clang++)
set(CMAKE_ASM_COMPILER @TC@/clang)
set(CMAKE_C_COMPILER_TARGET x86_64-apple-macosx10.15)
set(CMAKE_CXX_COMPILER_TARGET x86_64-apple-macosx10.15)
set(CMAKE_ASM_COMPILER_TARGET x86_64-apple-macosx10.15)
set(CMAKE_AR @TC@/llvm-ar CACHE FILEPATH "")
set(CMAKE_RANLIB @TC@/llvm-ranlib CACHE FILEPATH "")
set(CMAKE_INSTALL_NAME_TOOL @TC@/install_name_tool CACHE FILEPATH "")
set(CMAKE_OTOOL @TC@/otool CACHE FILEPATH "")

set(CMAKE_C_FLAGS_INIT "-Wno-nullability-completeness -Wno-incompatible-sysroot")
set(CMAKE_CXX_FLAGS_INIT "-Wno-nullability-completeness -Wno-incompatible-sysroot")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=@TC@/ld64")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=@TC@/ld64")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=@TC@/ld64")

# Libraries and headers from the SDK only; programs from the build host.
set(CMAKE_FIND_ROOT_PATH @SDK@)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
