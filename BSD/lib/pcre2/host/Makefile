# PCRE2 for the build host, under GLib's tools there (glib/host).

SUBDIR =
EXTLIB =	pcre2
EXTLIB_HOST =	yes
EXTLIB_MANIFEST = ${.CURDIR}/../MANIFEST
EXTLIB_SYSTEM =	cmake
EXTLIB_OPTIONS = -DPCRE2_BUILD_PCRE2_8=ON -DPCRE2_BUILD_PCRE2_16=OFF -DPCRE2_BUILD_PCRE2_32=OFF \
		-DPCRE2_BUILD_PCRE2GREP=OFF -DPCRE2_BUILD_TESTS=OFF -DBUILD_SHARED_LIBS=ON \
		-DPCRE2_SUPPORT_LIBZ=OFF -DPCRE2_SUPPORT_LIBBZ2=OFF -DPCRE2_SUPPORT_LIBREADLINE=OFF \
		-DPCRE2_SUPPORT_LIBEDIT=OFF

.include <minkar.extlib.mk>
