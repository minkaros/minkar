# PCRE2, the regular expressions glib uses (WebKit W0): the 8-bit library
# only, with its JIT.

SUBDIR =
EXTLIB =	pcre2
EXTLIB_SYSTEM =	cmake
EXTLIB_OPTIONS = -DPCRE2_BUILD_PCRE2_8=ON -DPCRE2_BUILD_PCRE2_16=OFF -DPCRE2_BUILD_PCRE2_32=OFF \
		-DPCRE2_SUPPORT_JIT=ON -DPCRE2_BUILD_PCRE2GREP=OFF -DPCRE2_BUILD_TESTS=OFF \
		-DPCRE2_SUPPORT_LIBZ=OFF -DPCRE2_SUPPORT_LIBBZ2=OFF -DPCRE2_SUPPORT_LIBREADLINE=OFF \
		-DPCRE2_SUPPORT_LIBEDIT=OFF
EXTLIB_LIBS =	libpcre2-8.0.dylib
EXTLIB_LICENSES = LICENCE.md

.include <minkar.extlib.mk>
