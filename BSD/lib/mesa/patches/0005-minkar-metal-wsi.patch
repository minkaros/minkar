+++ b/src/vulkan/wsi/wsi_common_minkar_layer.m
@@ -0,0 +1,134 @@
+/*
+ * Copyright (c) 2026 The Minkar contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+/*
+ * The Metal WSI's layer functions (wsi_common_metal_layer.h) without Metal,
+ * for Minkar: CAMetalLayer's drawables are IOSurfaces (BGRA8), and a
+ * presented frame is the CPU's copy of the swapchain image's buffer into
+ * one, which the layer then shows in its view.
+ */
+
+#include "wsi_common_metal_layer.h"
+
+#import <QuartzCore/CAMetalLayer.h>
+#import <IOSurface/IOSurfaceRef.h>
+#include <string.h>
+
+/* CAMetalLayer's IOSurface behind a drawable (QuartzCore's private
+ * interface). */
+@interface NSObject (CAMetalDrawableMinkar)
+- (IOSurfaceRef)_minkarIOSurface;
+@end
+
+void
+wsi_metal_layer_size(const CAMetalLayer *metal_layer, uint32_t *width, uint32_t *height)
+{
+   @autoreleasepool {
+      CGSize size = [(CAMetalLayer *)metal_layer drawableSize];
+      *width = (uint32_t)size.width;
+      *height = (uint32_t)size.height;
+   }
+}
+
+void
+wsi_metal_layer_set_immediate(const CAMetalLayer *metal_layer, bool enable_immediate)
+{
+   @autoreleasepool {
+      [(CAMetalLayer *)metal_layer setDisplaySyncEnabled:!enable_immediate];
+   }
+}
+
+VkResult
+wsi_metal_layer_configure(const CAMetalLayer *metal_layer, uint32_t width, uint32_t height,
+                          uint32_t image_count, VkFormat format, VkColorSpaceKHR color_space,
+                          bool enable_opaque, bool enable_immediate)
+{
+   @autoreleasepool {
+      CAMetalLayer *layer = (CAMetalLayer *)metal_layer;
+      MTLPixelFormat pixel_format;
+
+      switch (format) {
+      case VK_FORMAT_B8G8R8A8_UNORM:
+         pixel_format = MTLPixelFormatBGRA8Unorm;
+         break;
+      case VK_FORMAT_B8G8R8A8_SRGB:
+         pixel_format = MTLPixelFormatBGRA8Unorm_sRGB;
+         break;
+      default:
+         return VK_ERROR_FORMAT_NOT_SUPPORTED;
+      }
+      [layer setPixelFormat:pixel_format];
+      [layer setDrawableSize:CGSizeMake(width, height)];
+      [layer setMaximumDrawableCount:image_count < 2 ? 2 : image_count > 3 ? 3 : image_count];
+      [layer setOpaque:enable_opaque];
+      [layer setDisplaySyncEnabled:!enable_immediate];
+      return VK_SUCCESS;
+   }
+}
+
+void
+wsi_metal_layer_set_hdr_metadata(const CAMetalLayer *metal_layer, const VkHdrMetadataEXT *metadata)
+{
+   /* BGRA8 only: no HDR. */
+}
+
+CAMetalDrawable *
+wsi_metal_layer_acquire_drawable(const CAMetalLayer *metal_layer)
+{
+   @autoreleasepool {
+      id<CAMetalDrawable> drawable = [(CAMetalLayer *)metal_layer nextDrawable];
+      return (CAMetalDrawable *)[drawable retain];
+   }
+}
+
+void
+wsi_metal_release_drawable(CAMetalDrawable *drawable_ptr)
+{
+   [(id)drawable_ptr release];
+}
+
+/* Nothing to keep between frames: the copy is the CPU's. */
+struct wsi_metal_layer_blit_context {
+   int unused;
+};
+
+struct wsi_metal_layer_blit_context *
+wsi_create_metal_layer_blit_context()
+{
+   return calloc(1, sizeof(struct wsi_metal_layer_blit_context));
+}
+
+void
+wsi_destroy_metal_layer_blit_context(struct wsi_metal_layer_blit_context *context)
+{
+   free(context);
+}
+
+void
+wsi_metal_layer_blit_and_present(struct wsi_metal_layer_blit_context *context,
+                                 CAMetalDrawable **drawable_ptr, void *buffer,
+                                 uint32_t width, uint32_t height, uint32_t row_pitch)
+{
+   @autoreleasepool {
+      id drawable = (id)*drawable_ptr;
+      if (drawable == nil)
+         return;
+      IOSurfaceRef surface = [drawable _minkarIOSurface];
+      if (surface != NULL && buffer != NULL) {
+         IOSurfaceLock(surface, 0, NULL);
+         uint8_t *dst = IOSurfaceGetBaseAddress(surface);
+         size_t dst_pitch = IOSurfaceGetBytesPerRow(surface);
+         size_t rows = height < IOSurfaceGetHeight(surface) ? height : IOSurfaceGetHeight(surface);
+         size_t w = width < IOSurfaceGetWidth(surface) ? width : IOSurfaceGetWidth(surface);
+         for (size_t y = 0; y < rows; y++)
+            memcpy(dst + y * dst_pitch, (const uint8_t *)buffer + y * row_pitch, w * 4);
+         IOSurfaceUnlock(surface, 0, NULL);
+      }
+      [(id<CAMetalDrawable>)drawable present];
+      [drawable release];
+      *drawable_ptr = NULL;
+   }
+}
