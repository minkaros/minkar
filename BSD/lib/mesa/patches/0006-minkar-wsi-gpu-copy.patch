+/*
+ * The present's commands for this drawable: the image copied by the GPU
+ * into the drawable's IOSurface, rows as the surface lays them out. Two
+ * command buffers a queue in turn, as the Metal path keeps them.
+ */
+static VkResult
+wsi_minkar_record_copy(struct wsi_metal_swapchain *chain, struct wsi_metal_image *metal_image)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   struct wsi_image *image = &metal_image->base;
+   struct wsi_metal_layer_surface s;
+   int queue_count = chain->base.blit.queue != NULL ? 1 : wsi->queue_family_count;
+   VkResult result = VK_SUCCESS;
+
+   VkBuffer buffer = wsi_minkar_import(chain, metal_image->drawable);
+   if (buffer == VK_NULL_HANDLE ||
+       !wsi_metal_layer_drawable_surface(metal_image->drawable, &s))
+      return VK_ERROR_OUT_OF_DATE_KHR;
+
+   for (int i = 0; i < queue_count; i++) {
+      if (!chain->base.cmd_pools[i])
+         continue;
+      wsi->FreeCommandBuffers(chain->base.device, chain->base.cmd_pools[i], 1,
+                              &image->blit.cmd_buffers[i + queue_count]);
+      image->blit.cmd_buffers[i + queue_count] = image->blit.cmd_buffers[i];
+      const VkCommandBufferAllocateInfo cmd_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = chain->base.cmd_pools[i],
+         .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+         .commandBufferCount = 1,
+      };
+      result = wsi->AllocateCommandBuffers(chain->base.device, &cmd_info,
+                                           &image->blit.cmd_buffers[i]);
+      if (result != VK_SUCCESS)
+         return result;
+      VkCommandBuffer cmd = image->blit.cmd_buffers[i];
+      const VkCommandBufferBeginInfo begin_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      };
+      wsi->BeginCommandBuffer(cmd, &begin_info);
+
+      VkImageMemoryBarrier barrier = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .srcAccessMask = 0,
+         .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+         .oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+         .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .image = image->image,
+         .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+      };
+      wsi->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                              VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &barrier);
+
+      const uint32_t width = MIN2(chain->extent.width, s.width);
+      const uint32_t height = MIN2(chain->extent.height, s.height);
+      const VkBufferImageCopy region = {
+         .bufferOffset = 0,
+         .bufferRowLength = s.row_bytes / 4,
+         .bufferImageHeight = s.height,
+         .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+         .imageOffset = { 0, 0, 0 },
+         .imageExtent = { width, height, 1 },
+      };
+      wsi->CmdCopyImageToBuffer(cmd, image->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                                buffer, 1, &region);
+
+      /* The image back for the app; the copy made visible to whoever
+       * reads the surface next (the window server's compositor). */
+      barrier.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+      barrier.dstAccessMask = 0;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      barrier.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+      const VkBufferMemoryBarrier written = {
+         .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_HOST_READ_BIT,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .buffer = buffer,
+         .offset = 0,
+         .size = VK_WHOLE_SIZE,
+      };
+      wsi->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                              VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+                              0, 0, NULL, 1, &written, 1, &barrier);
+      result = wsi->EndCommandBuffer(cmd);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   return VK_SUCCESS;
+}
