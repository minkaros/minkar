+static void
+wsi_minkar_forget_import(struct wsi_metal_swapchain *chain, struct wsi_minkar_import *import)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+
+   if (import->buffer != VK_NULL_HANDLE)
+      wsi->DestroyBuffer(chain->base.device, import->buffer, &chain->base.alloc);
+   if (import->memory != VK_NULL_HANDLE)
+      wsi->FreeMemory(chain->base.device, import->memory, &chain->base.alloc);
+   memset(import, 0, sizeof(*import));
+}
