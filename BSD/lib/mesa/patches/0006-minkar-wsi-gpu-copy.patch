+/*
+ * A drawable's IOSurface as a buffer the GPU writes: its VRAM imported by
+ * the shared buffer's descriptor (a dma-buf), or its memory in place
+ * (VK_EXT_external_memory_host) when it is in the system's; kept for the
+ * next time the layer gives the same surface.
+ */
+static VkBuffer
+wsi_minkar_import(struct wsi_metal_swapchain *chain, CAMetalDrawable *drawable)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   struct wsi_metal_layer_surface s;
+
+   if (!wsi_metal_layer_drawable_surface(drawable, &s))
+      return VK_NULL_HANDLE;
+   for (uint32_t i = 0; i < ARRAY_SIZE(chain->imports); i++)
+      if (chain->imports[i].surface_id == s.surface_id && chain->imports[i].buffer)
+         return chain->imports[i].buffer;
+
+   struct wsi_minkar_import *import =
+      &chain->imports[chain->import_next++ % ARRAY_SIZE(chain->imports)];
+   wsi_minkar_forget_import(chain, import);
+
+   const VkExternalMemoryHandleTypeFlagBits type = s.gpu_name ?
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT :
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+   const VkExternalMemoryBufferCreateInfo external = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+      .handleTypes = type,
+   };
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .pNext = &external,
+      .size = s.size,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   if (wsi->CreateBuffer(chain->base.device, &buffer_info, &chain->base.alloc,
+                         &import->buffer) != VK_SUCCESS) {
+      import->buffer = VK_NULL_HANDLE;
+      return VK_NULL_HANDLE;
+   }
+   VkMemoryRequirements reqs;
+   wsi->GetBufferMemoryRequirements(chain->base.device, import->buffer, &reqs);
+
+   int fd = s.gpu_name ? minkar_drm_shared_buffer_fd(s.gpu_name) : -1;
+   /* The memory types the import may take. */
+   uint32_t type_bits = reqs.memoryTypeBits;
+   if (fd >= 0 && wsi->GetMemoryFdPropertiesKHR) {
+      VkMemoryFdPropertiesKHR fd_props = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+      };
+      if (wsi->GetMemoryFdPropertiesKHR(chain->base.device, type, fd, &fd_props) == VK_SUCCESS)
+         type_bits &= fd_props.memoryTypeBits;
+   } else if (!s.gpu_name && wsi->GetMemoryHostPointerPropertiesEXT) {
+      VkMemoryHostPointerPropertiesEXT host_props = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT,
+      };
+      if (wsi->GetMemoryHostPointerPropertiesEXT(chain->base.device, type, s.base,
+                                                 &host_props) == VK_SUCCESS)
+         type_bits &= host_props.memoryTypeBits;
+   }
+   const VkImportMemoryFdInfoKHR fd_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = fd,
+   };
+   const VkImportMemoryHostPointerInfoEXT host_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+      .pHostPointer = s.base,
+   };
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = s.gpu_name ? (const void *)&fd_info : (const void *)&host_info,
+      .allocationSize = s.size,
+      .memoryTypeIndex = wsi_select_memory_type(wsi, 0, 0, type_bits),
+   };
+   if ((s.gpu_name && fd < 0) ||
+       wsi->AllocateMemory(chain->base.device, &alloc_info, &chain->base.alloc,
+                           &import->memory) != VK_SUCCESS) {
+      if (fd >= 0)
+         close(fd);      /* Vulkan owns it only once imported */
+      import->memory = VK_NULL_HANDLE;
+      wsi_minkar_forget_import(chain, import);
+      return VK_NULL_HANDLE;
+   }
+   if (wsi->BindBufferMemory(chain->base.device, import->buffer, import->memory, 0) !=
+       VK_SUCCESS) {
+      wsi_minkar_forget_import(chain, import);
+      return VK_NULL_HANDLE;
+   }
+   import->surface_id = s.surface_id;
+   return import->buffer;
+}
