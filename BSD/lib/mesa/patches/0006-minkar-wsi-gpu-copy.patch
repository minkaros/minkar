+/* IOSurfaces in VRAM go to the GPU that lights the display (IOSurface's
+ * choice): is that the GPU with this render node? MINKAR_WSI_CPU keeps
+ * the CPU's copy. */
+bool
+wsi_metal_layer_gpu_holds_drawables(int64_t render_minor)
+{
+   io_iterator_t it;
+   io_service_t s;
+   bool holds = false;
+
+   if (getenv("MINKAR_WSI_CPU") != NULL)
+      return false;
+   if (IOServiceGetMatchingServices(kIOMasterPortDefault, IOServiceMatching("MinkarAMDGPU"),
+                                    &it) != KERN_SUCCESS)
+      return false;
+   while ((s = IOIteratorNext(it)) != IO_OBJECT_NULL) {
+      int minor = -1;
+      CFTypeRef m = IORegistryEntryCreateCFProperty(s, CFSTR("MinkarDRMMinor"),
+                                                    kCFAllocatorDefault, 0);
+      CFTypeRef lights = IORegistryEntryCreateCFProperty(s, CFSTR("MinkarLightsDisplay"),
+                                                         kCFAllocatorDefault, 0);
+      if (m != NULL && CFGetTypeID(m) == CFNumberGetTypeID())
+         CFNumberGetValue(m, kCFNumberIntType, &minor);
+      if (minor == render_minor && lights == kCFBooleanTrue)
+         holds = true;
+      if (m != NULL)
+         CFRelease(m);
+      if (lights != NULL)
+         CFRelease(lights);
+      IOObjectRelease(s);
+   }
+   IOObjectRelease(it);
+   return holds;
+}
