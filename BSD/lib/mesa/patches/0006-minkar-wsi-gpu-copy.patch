+bool
+wsi_metal_layer_drawable_surface(CAMetalDrawable *drawable, struct wsi_metal_layer_surface *s)
+{
+   IOSurfaceRef surface = drawable ? [(id)drawable _minkarIOSurface] : NULL;
+
+   if (surface == NULL)
+      return false;
+   s->surface_id = IOSurfaceGetID(surface);
+   s->base = IOSurfaceGetBaseAddress(surface);
+   /* Whole pages: an import takes them so. */
+   s->size = (IOSurfaceGetAllocSize(surface) + 4095) & ~(uint64_t)4095;
+   s->width = (uint32_t)IOSurfaceGetWidth(surface);
+   s->height = (uint32_t)IOSurfaceGetHeight(surface);
+   s->row_bytes = (uint32_t)IOSurfaceGetBytesPerRow(surface);
+   s->gpu_name = IOSurfaceGetMinkarGPUBuffer(surface);
+   return s->row_bytes % 4 == 0;
+}
+
+void
+wsi_metal_layer_present_drawable(CAMetalDrawable **drawable_ptr)
+{
+   @autoreleasepool {
+      id drawable = (id)*drawable_ptr;
+      if (drawable == nil)
+         return;
+      [(id<CAMetalDrawable>)drawable present];
+      [drawable release];
+      *drawable_ptr = NULL;
+   }
+}
