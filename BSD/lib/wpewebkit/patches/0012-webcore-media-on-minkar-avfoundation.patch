+/* Web Audio's FFT on FFmpeg's real transforms (libavutil's av_tx, in
+   /usr/lib/media): N real samples to N/2+1 complex values, not normalized
+   forward, scaled by 1/N back, as the other platforms' frames are. */
+
+#include "config.h"
+#include "FFTFrame.h"
+
+#if ENABLE(WEB_AUDIO) && USE(MINKAR_MEDIA)
+
+#include "VectorMath.h"
+#include <wtf/StdLibExtras.h>
+
+extern "C" {
+#include <libavutil/mem.h>
+#include <libavutil/tx.h>
+}
+
+namespace WebCore {
+
+namespace {
+const int kMinFFTPow2Size = 2;
+const int kMaxFFTPow2Size = 24;
+
+size_t unpackedFFTDataSize(unsigned fftSize)
+{
+    return fftSize / 2 + 1;
+}
+}
+
+void FFTFrame::setUpTransforms()
+{
+    if (!m_FFTSize)
+        return;
+    float scale = 1;
+    float inverseScale = 1.0f / m_FFTSize;
+    av_tx_init(&m_forward, &m_forwardFunction, AV_TX_FLOAT_RDFT, 0, m_FFTSize, &scale, 0);
+    av_tx_init(&m_inverse, &m_inverseFunction, AV_TX_FLOAT_RDFT, 1, m_FFTSize, &inverseScale, 0);
+    m_complexData.resize(unpackedFFTDataSize(m_FFTSize));
+    m_samples.resize(m_FFTSize);
+}
+
+FFTFrame::FFTFrame(unsigned fftSize)
+    : m_FFTSize(fftSize)
+    , m_log2FFTSize(static_cast<unsigned>(log2(fftSize)))
+    , m_realData(unpackedFFTDataSize(m_FFTSize))
+    , m_imagData(unpackedFFTDataSize(m_FFTSize))
+{
+    setUpTransforms();
+}
+
+FFTFrame::FFTFrame()
+    : m_FFTSize(0)
+    , m_log2FFTSize(0)
+{
+}
+
+FFTFrame::FFTFrame(const FFTFrame& frame)
+    : m_FFTSize(frame.m_FFTSize)
+    , m_log2FFTSize(frame.m_log2FFTSize)
+    , m_realData(unpackedFFTDataSize(frame.m_FFTSize))
+    , m_imagData(unpackedFFTDataSize(frame.m_FFTSize))
+{
+    setUpTransforms();
+    memcpySpan(m_realData.span(), frame.realData().span());
+    memcpySpan(m_imagData.span(), frame.imagData().span());
+}
+
+void FFTFrame::initialize()
+{
+}
+
+FFTFrame::~FFTFrame()
+{
+    av_tx_uninit(&m_forward);
+    av_tx_uninit(&m_inverse);
+}
+
+void FFTFrame::doFFT(std::span<const float> data)
+{
+    /* The transform may use its input as scratch: a copy. */
+    memcpySpan(m_samples.mutableSpan(), data.first(m_FFTSize));
+    m_forwardFunction(m_forward, m_complexData.mutableSpan().data(), m_samples.mutableSpan().data(), sizeof(float));
+    auto realData = m_realData.span();
+    auto imagData = m_imagData.span();
+    for (size_t i = 0; i < unpackedFFTDataSize(m_FFTSize); ++i) {
+        realData[i] = m_complexData[i].re;
+        imagData[i] = m_complexData[i].im;
+    }
+}
+
+void FFTFrame::doInverseFFT(std::span<float> data)
+{
+    auto realData = m_realData.span();
+    auto imagData = m_imagData.span();
+    for (size_t i = 0; i < unpackedFFTDataSize(m_FFTSize); ++i) {
+        m_complexData[i].re = realData[i];
+        m_complexData[i].im = imagData[i];
+    }
+    m_inverseFunction(m_inverse, data.data(), m_complexData.mutableSpan().data(), sizeof(AVComplexFloat));
+}
+
+int FFTFrame::minFFTSize()
+{
+    return 1 << kMinFFTPow2Size;
+}
+
+int FFTFrame::maxFFTSize()
+{
+    return 1 << kMaxFFTPow2Size;
+}
+
+} // namespace WebCore
+
+#endif
