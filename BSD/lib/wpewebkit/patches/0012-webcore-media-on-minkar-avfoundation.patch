+
+/* decodeAudioData's files: decoded by the media decoder (FFmpeg) through
+   AVFoundation, at the context's rate, into an audio bus. */
+
+#include "config.h"
+#include "AudioFileReader.h"
+
+#if ENABLE(WEB_AUDIO) && USE(MINKAR_MEDIA)
+
+#include "AudioBus.h"
+#include <AVFoundation/AVMinkarPlayback.h>
+#include <wtf/StdLibExtras.h>
+
+namespace WebCore {
+
+RefPtr<AudioBus> createBusFromInMemoryAudioFile(std::span<const uint8_t> data, bool mixToMono, float sampleRate)
+{
+    float* samples = nullptr;
+    int channels = 0;
+    size_t frames = 0;
+    if (!AVMinkarDecodeAudio(data.data(), data.size(), sampleRate, mixToMono, &channels, &frames, &samples))
+        return nullptr;
+    auto bus = AudioBus::create(channels, frames);
+    bus->setSampleRate(sampleRate);
+    for (int c = 0; c < channels; ++c) {
+        auto destination = bus->channel(c)->mutableSpan();
+        for (size_t i = 0; i < frames; ++i)
+            destination[i] = samples[i * channels + c];
+    }
+    free(samples);
+    return bus;
+}
+
+} // namespace WebCore
+
+#endif
