+
+namespace WebCore {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(MediaPlayerPrivateMinkar);
+
+/* What the playback says, carried to the main thread: the bridge outlives
+   the player (the playback holds it as its callback's context). */
+class MediaPlayerPrivateMinkarBridge : public ThreadSafeRefCounted<MediaPlayerPrivateMinkarBridge> {
+public:
+    static Ref<MediaPlayerPrivateMinkarBridge> create(MediaPlayerPrivateMinkar& owner) { return adoptRef(*new MediaPlayerPrivateMinkarBridge(owner)); }
+    static void callback(void* context, int event)
+    {
+        Ref bridge = *static_cast<MediaPlayerPrivateMinkarBridge*>(context);
+        callOnMainThread([bridge = WTF::move(bridge), event] {
+            if (RefPtr owner = bridge->m_owner.get())
+                owner->playbackEvent(event);
+        });
+    }
+    void detach() { m_owner = nullptr; }
+private:
+    explicit MediaPlayerPrivateMinkarBridge(MediaPlayerPrivateMinkar& owner) : m_owner(owner) { }
+    WeakPtr<MediaPlayerPrivateMinkar> m_owner;
+};
+
+/* The loader's client: the download into the stream (on the main thread). */
+class MediaPlayerPrivateMinkarClient final : public PlatformMediaResourceClient {
+public:
+    static Ref<MediaPlayerPrivateMinkarClient> create(MediaPlayerPrivateMinkar& owner) { return adoptRef(*new MediaPlayerPrivateMinkarClient(owner)); }
+private:
+    explicit MediaPlayerPrivateMinkarClient(MediaPlayerPrivateMinkar& owner) : m_owner(owner) { }
+
+    void responseReceived(PlatformMediaResource&, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completionHandler) final
+    {
+        RefPtr owner = m_owner.get();
+        if (owner) {
+            if (response.httpStatusCode() >= 400)
+                owner->loaderFinished(true);
+            else
+                owner->loaderResponse(response.expectedContentLength());
+        }
+        completionHandler(ShouldContinuePolicyCheck::Yes);
+    }
+    void dataReceived(PlatformMediaResource&, const SharedBuffer& buffer) final
+    {
+        RefPtr owner = m_owner.get();
+        if (!owner)
+            return;
+        buffer.forEachSegment([&](std::span<const uint8_t> segment) {
+            owner->loaderData(segment);
+        });
+    }
+    void accessControlCheckFailed(PlatformMediaResource&, const ResourceError&) final
+    {
+        if (RefPtr owner = m_owner.get())
+            owner->loaderFinished(true);
+    }
+    void loadFailed(PlatformMediaResource&, const ResourceError&) final
+    {
+        if (RefPtr owner = m_owner.get())
+            owner->loaderFinished(true);
+    }
+    void loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&) final
+    {
+        if (RefPtr owner = m_owner.get())
+            owner->loaderFinished(false);
+    }
+
+    WeakPtr<MediaPlayerPrivateMinkar> m_owner;
+};
+
+MediaPlayerPrivateMinkar::MediaPlayerPrivateMinkar(MediaPlayer& player)
+    : m_player(player)
+    , m_timer(RunLoop::mainSingleton(), "MediaPlayerPrivateMinkar::Timer"_s, this, &MediaPlayerPrivateMinkar::tick)
+{
+}
+
+MediaPlayerPrivateMinkar::~MediaPlayerPrivateMinkar()
+{
+    cancelLoad();
+}
+
+void MediaPlayerPrivateMinkar::setNetworkState(MediaPlayer::NetworkState state)
+{
+    if (m_networkState == state)
+        return;
+    m_networkState = state;
+    if (RefPtr player = m_player.get())
+        player->networkStateChanged();
+}
+
+void MediaPlayerPrivateMinkar::setReadyState(MediaPlayer::ReadyState state)
+{
+    if (m_readyState == state)
+        return;
+    m_readyState = state;
+    if (RefPtr player = m_player.get())
+        player->readyStateChanged();
+}
+
+void MediaPlayerPrivateMinkar::load(const String& urlString)
+{
+    cancelLoad();
+    URL url { urlString };
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+    setReadyState(MediaPlayer::ReadyState::HaveNothing);
+    m_bridge = MediaPlayerPrivateMinkarBridge::create(*this);
+
+    if (url.protocolIsFile()) {
+        m_playback = AVMinkarPlaybackCreateWithPath(url.fileSystemPath().utf8().data(), MediaPlayerPrivateMinkarBridge::callback, m_bridge.get());
+        if (!m_playback)
+            setNetworkState(MediaPlayer::NetworkState::FormatError);
+        return;
+    }
+
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+    m_stream = AVMinkarStreamCreate(-1);
+    if (!m_stream) {
+        setNetworkState(MediaPlayer::NetworkState::NetworkError);
+        return;
+    }
+    m_resource = player->mediaResourceLoader()->requestResource(ResourceRequest { URL { url } }, PlatformMediaResourceLoader::LoadOption::DisallowCaching);
+    if (!m_resource) {
+        setNetworkState(MediaPlayer::NetworkState::NetworkError);
+        return;
+    }
+    m_resource->setClient(MediaPlayerPrivateMinkarClient::create(*this));
+    startPlayback(url.lastPathComponent().toString());
+}
+
+void MediaPlayerPrivateMinkar::startPlayback(const String& name)
+{
+    m_playback = AVMinkarPlaybackCreateWithStream(m_stream, name.utf8().data(), MediaPlayerPrivateMinkarBridge::callback, m_bridge.get());
+    if (!m_playback)
+        setNetworkState(MediaPlayer::NetworkState::FormatError);
+}
+
+void MediaPlayerPrivateMinkar::cancelLoad()
+{
+    m_timer.stop();
+    if (m_resource) {
+        m_resource->shutdown();
+        m_resource = nullptr;
+    }
+    if (m_bridge) {
+        m_bridge->detach();
+        m_bridge = nullptr;
+    }
+    if (m_playback) {
+        AVMinkarPlaybackRelease(m_playback);
+        m_playback = nullptr;
+    }
+    if (m_stream) {
+        AVMinkarStreamFinish(m_stream);
+        AVMinkarStreamRelease(m_stream);
+        m_stream = nullptr;
+    }
+    if (m_seekPromise)
+        std::exchange(m_seekPromise, std::nullopt)->reject(PlatformMediaError::Cancelled);
+    m_ready = false;
+    m_frame = nullptr;
+    m_frameTime = -1;
+}
+
+void MediaPlayerPrivateMinkar::loaderResponse(long long expectedLength)
+{
+    /* The stream was made before the length was known: the decoder learns
+       the end when the download is over. */
+    UNUSED_PARAM(expectedLength);
+}
+
+void MediaPlayerPrivateMinkar::loaderData(std::span<const uint8_t> bytes)
+{
+    if (m_stream && !AVMinkarStreamAppend(m_stream, bytes.data(), bytes.size()))
+        loaderFinished(true);
+}
+
+void MediaPlayerPrivateMinkar::loaderFinished(bool failed)
+{
+    if (m_stream)
+        AVMinkarStreamFinish(m_stream);
+    m_loadFailed = failed;
+    if (failed && !m_ready)
+        setNetworkState(MediaPlayer::NetworkState::NetworkError);
+    else if (!failed && m_ready)
+        setNetworkState(MediaPlayer::NetworkState::Idle);
+}
+
+void MediaPlayerPrivateMinkar::playbackEvent(int event)
+{
+    RefPtr player = m_player.get();
+    switch (event) {
+    case kAVMinkarPlaybackReady: {
+        m_ready = true;
+        m_hasVideo = AVMinkarPlaybackHasVideo(m_playback);
+        m_hasAudio = AVMinkarPlaybackHasAudio(m_playback);
+        double w = 0, h = 0;
+        AVMinkarPlaybackGetNaturalSize(m_playback, &w, &h);
+        m_naturalSize = FloatSize(w, h);
+        AVMinkarPlaybackSetVolume(m_playback, m_muted ? 0 : m_volume);
+        if (player) {
+            player->characteristicChanged();
+            player->durationChanged();
+            player->sizeChanged();
+        }
+        setReadyState(MediaPlayer::ReadyState::HaveMetadata);
+        updateFrame();
+        setReadyState(MediaPlayer::ReadyState::HaveEnoughData);
+        if (!m_stream || AVMinkarStreamIsFinished(m_stream))
+            setNetworkState(MediaPlayer::NetworkState::Idle);
+        if (!m_paused)
+            applyRate();
+        m_timer.startRepeating(16_ms);
+        break;
+    }
+    case kAVMinkarPlaybackFailed:
+        setNetworkState(m_loadFailed ? MediaPlayer::NetworkState::NetworkError : MediaPlayer::NetworkState::FormatError);
+        break;
+    case kAVMinkarPlaybackEnded:
+        /* At the end the element pauses itself, seeing the time at the
+           duration. */
+        updateFrame();
+        if (player)
+            player->timeChanged();
+        break;
+    case kAVMinkarPlaybackSeeked:
+        m_frameTime = -1;
+        updateFrame();
+        if (m_seekPromise)
+            std::exchange(m_seekPromise, std::nullopt)->resolve(currentTime());
+        if (player)
+            player->timeChanged();
+        if (!m_paused)
+            applyRate();
+        break;
+    }
+}
+
+void MediaPlayerPrivateMinkar::applyRate()
+{
+    if (m_playback && m_ready)
+        AVMinkarPlaybackSetRate(m_playback, m_paused ? 0 : m_rate);
+}
+
+void MediaPlayerPrivateMinkar::play()
+{
+    m_paused = false;
+    applyRate();
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
+
+void MediaPlayerPrivateMinkar::pause()
+{
+    m_paused = true;
+    applyRate();
+    if (RefPtr player = m_player.get())
+        player->playbackStateChanged();
+}
+
+void MediaPlayerPrivateMinkar::setRate(float rate)
+{
+    m_rate = rate > 0 ? rate : 1;
+    applyRate();
+}
+
+MediaTime MediaPlayerPrivateMinkar::duration() const
+{
+    if (!m_playback || !m_ready)
+        return MediaTime::invalidTime();
+    double d = AVMinkarPlaybackGetDuration(m_playback);
+    return std::isnan(d) ? MediaTime::positiveInfiniteTime() : MediaTime::createWithDouble(d);
+}
+
+MediaTime MediaPlayerPrivateMinkar::currentTime() const
+{
+    if (m_seekPromise && m_seekTarget)
+        return *m_seekTarget;
+    if (!m_playback || !m_ready)
+        return MediaTime::zeroTime();
+    return MediaTime::createWithDouble(AVMinkarPlaybackGetCurrentTime(m_playback));
+}
+
+Ref<MediaTimePromise> MediaPlayerPrivateMinkar::seekToTarget(const SeekTarget& target)
+{
+    if (m_seekPromise)
+        std::exchange(m_seekPromise, std::nullopt)->reject(PlatformMediaError::Cancelled);
+    if (!m_playback || !m_ready)
+        return MediaTimePromise::createAndReject(PlatformMediaError::Cancelled);
+    m_seekTarget = target.time;
+    m_seekPromise.emplace(PlatformMediaError::Cancelled);
+    Ref promise = m_seekPromise->promise();
+    AVMinkarPlaybackSetRate(m_playback, 0);
+    AVMinkarPlaybackSeek(m_playback, target.time.toDouble());
+    return promise;
+}
+
+void MediaPlayerPrivateMinkar::setVolume(float volume)
+{
+    m_volume = volume;
+    if (m_playback && m_ready)
+        AVMinkarPlaybackSetVolume(m_playback, m_muted ? 0 : m_volume);
+}
+
+void MediaPlayerPrivateMinkar::setMuted(bool muted)
+{
+    m_muted = muted;
+    setVolume(m_volume);
+}
+
+const PlatformTimeRanges& MediaPlayerPrivateMinkar::buffered() const
+{
+    m_buffered.clear();
+    MediaTime d = duration();
+    if (!d.isValid() || !d.isFinite())
+        return m_buffered;
+    double fraction = 1;
+    if (m_stream && !AVMinkarStreamIsFinished(m_stream)) {
+        long long expected = AVMinkarStreamGetExpectedLength(m_stream);
+        fraction = expected > 0 ? std::min(1.0, static_cast<double>(AVMinkarStreamGetLength(m_stream)) / expected) : 0;
+    }
+    if (fraction > 0)
+        m_buffered.add(MediaTime::zeroTime(), MediaTime::createWithDouble(d.toDouble() * fraction));
+    return m_buffered;
+}
+
+bool MediaPlayerPrivateMinkar::didLoadingProgress() const
+{
+    long long length = m_stream ? AVMinkarStreamGetLength(m_stream) : 0;
+    bool progressed = length != m_lastProgressLength;
+    m_lastProgressLength = length;
+    return progressed;
+}
+
+unsigned long long MediaPlayerPrivateMinkar::totalBytes() const
+{
+    if (!m_stream)
+        return 0;
+    long long expected = AVMinkarStreamGetExpectedLength(m_stream);
+    return expected > 0 ? expected : AVMinkarStreamGetLength(m_stream);
+}
+
+/* A frame painted now reaches the screen some refreshes later: the web
+   process paints the page, the UI process takes it and its view draws it
+   (about four refreshes at 60 Hz, measured against the sound card). While
+   playing, the frame painted is the one due then, so picture and sound
+   meet. */
+static constexpr double kPaintToScreenSeconds = 0.066;
+
+/* The frame due, as an image, when it is a new one. */
+void MediaPlayerPrivateMinkar::updateFrame()
+{
+    if (!m_playback || !m_ready || !m_hasVideo)
+        return;
+    double frameTime = -1;
+    double time = AVMinkarPlaybackGetCurrentTime(m_playback);
+    if (!m_paused)
+        time += kPaintToScreenSeconds;
+    CVPixelBufferRef buffer = AVMinkarPlaybackCopyFrame(m_playback, time, &frameTime);
+    if (!buffer)
+        return;
+    if (frameTime == m_frameTime && m_frame) {
+        CVPixelBufferRelease(buffer);
+        return;
+    }
+    CVPixelBufferLockBaseAddress(buffer, kCVPixelBufferLock_ReadOnly);
+    size_t width = CVPixelBufferGetWidth(buffer), height = CVPixelBufferGetHeight(buffer);
+    SkPixmap pixmap(SkImageInfo::Make(width, height, kBGRA_8888_SkColorType, kOpaque_SkAlphaType),
+        CVPixelBufferGetBaseAddress(buffer), CVPixelBufferGetBytesPerRow(buffer));
+    m_frame = NativeImage::create(SkImages::RasterFromPixmapCopy(pixmap));
+    CVPixelBufferUnlockBaseAddress(buffer, kCVPixelBufferLock_ReadOnly);
+    CVPixelBufferRelease(buffer);
+    m_frameTime = frameTime;
+    if (RefPtr player = m_player.get()) {
+        player->repaint();
+        player->firstVideoFrameAvailable();
+    }
+}
+
+/* At the page's pace: the frame due, the time going on, the end. Paused,
+   only until a frame is shown (the first one, or the one a seek lands
+   on: the decoder brings it a moment later). */
+void MediaPlayerPrivateMinkar::tick()
+{
+    if (!m_playback || !m_ready)
+        return;
+    if (m_paused) {
+        if (m_frameTime < 0)
+            updateFrame();
+        return;
+    }
+    updateFrame();
+    AVMinkarPlaybackIsAtEnd(m_playback);
+}
+
+void MediaPlayerPrivateMinkar::paint(GraphicsContext& context, const FloatRect& rect)
+{
+    if (context.paintingDisabled() || !m_frame)
+        return;
+    auto size = m_frame->size();
+    context.drawNativeImage(*m_frame, rect, FloatRect(0, 0, size.width(), size.height()));
+}
+
+RefPtr<NativeImage> MediaPlayerPrivateMinkar::nativeImageForCurrentTime()
+{
+    updateFrame();
+    return m_frame;
+}
+
+/* ---- Types ------------------------------------------------------------------- */
+
+static const HashSet<String>& mimeTypes()
+{
+    static NeverDestroyed<HashSet<String>> types = [] {
+        HashSet<String> set;
+        for (auto type : { "video/mp4"_s, "video/x-m4v"_s, "video/quicktime"_s, "video/webm"_s, "video/ogg"_s,
+            "video/x-matroska"_s, "video/mpeg"_s, "video/x-msvideo"_s, "audio/mp4"_s, "audio/x-m4a"_s,
+            "audio/aac"_s, "audio/mpeg"_s, "audio/mp3"_s, "audio/ogg"_s, "audio/opus"_s, "audio/webm"_s,
+            "audio/flac"_s, "audio/x-flac"_s, "audio/wav"_s, "audio/x-wav"_s, "audio/wave"_s, "audio/aiff"_s,
+            "audio/x-aiff"_s })
+            set.add(type);
+        return set;
+    }();
+    return types;
+}
+
+void MediaPlayerPrivateMinkar::getSupportedTypes(HashSet<String>& types)
+{
+    types = mimeTypes();
+}
+
+/* The codecs FFmpeg decodes here (RFC 6381 names, before their first dot). */
+static bool codecSupported(const String& codec)
+{
+    auto name = codec.left(codec.find('.')).convertToASCIILowercase();
+    for (auto known : { "avc1"_s, "avc3"_s, "hvc1"_s, "hev1"_s, "vp8"_s, "vp08"_s, "vp9"_s, "vp09"_s, "av01"_s,
+        "mp4v"_s, "mp4a"_s, "opus"_s, "vorbis"_s, "flac"_s, "alac"_s, "mp3"_s, "theora"_s, "pcm"_s, "1"_s }) {
+        if (name == known)
+            return true;
+    }
+    return false;
+}
+
+MediaPlayer::SupportsType MediaPlayerPrivateMinkar::supportsType(const MediaEngineSupportParameters& parameters)
+{
+    if (parameters.platformType != PlatformMediaDecodingType::FileOrHLS)
+        return MediaPlayer::SupportsType::IsNotSupported;
+    auto container = parameters.type.containerType().convertToASCIILowercase();
+    if (container.isEmpty() || !mimeTypes().contains(container))
+        return MediaPlayer::SupportsType::IsNotSupported;
+    auto codecs = parameters.type.codecs();
+    if (codecs.isEmpty())
+        return MediaPlayer::SupportsType::MayBeSupported;
+    for (auto& codec : codecs) {
+        if (!codecSupported(codec))
+            return MediaPlayer::SupportsType::IsNotSupported;
+    }
+    return MediaPlayer::SupportsType::IsSupported;
+}
+
+class MediaPlayerFactoryMinkar final : public MediaPlayerFactory {
+    WTF_MAKE_TZONE_ALLOCATED_INLINE(MediaPlayerFactoryMinkar);
+    WTF_OVERRIDE_DELETE_FOR_CHECKED_PTR(MediaPlayerFactoryMinkar);
+private:
+    MediaPlayerEnums::MediaEngineIdentifier identifier() const final { return MediaPlayerEnums::MediaEngineIdentifier::Minkar; }
+    Ref<MediaPlayerPrivateInterface> createMediaEnginePlayer(MediaPlayer& player) const final { return adoptRef(*new MediaPlayerPrivateMinkar(player)); }
+    void getSupportedTypes(HashSet<String>& types) const final { MediaPlayerPrivateMinkar::getSupportedTypes(types); }
+    MediaPlayer::SupportsType supportsTypeAndCodecs(const MediaEngineSupportParameters& parameters) const final { return MediaPlayerPrivateMinkar::supportsType(parameters); }
+};
+
+void MediaPlayerPrivateMinkar::registerMediaEngine(MediaEngineRegistrar registrar)
+{
+    registrar(makeUnique<MediaPlayerFactoryMinkar>());
+}
+
+} // namespace WebCore
