+ * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "AudioDestinationMinkar.h"
+
+#if ENABLE(WEB_AUDIO) && USE(MINKAR_MEDIA)
+
+#include "AudioBus.h"
+#include "AudioUtilities.h"
+#include <AudioToolbox/AudioQueue.h>
+#include <mach/mach_time.h>
+#include <wtf/MainThread.h>
+
+namespace WebCore {
+
+static constexpr float kDeviceSampleRate = 48000;
+static constexpr unsigned kBufferFrames = 512;
+static constexpr unsigned kBufferCount = 3;
+
+Ref<AudioDestination> AudioDestination::create(const CreationOptions& options)
+{
+    return adoptRef(*new AudioDestinationMinkar(options));
+}
+
+float AudioDestination::hardwareSampleRate()
+{
+    return kDeviceSampleRate;
+}
+
+unsigned long AudioDestination::maxChannelCount()
+{
+    return 2;
+}
+
+static void queueCallback(void* refcon, AudioQueueRef, AudioQueueBufferRef buffer)
+{
+    static_cast<AudioDestinationMinkar*>(refcon)->fill(buffer);
+}
+
+AudioDestinationMinkar::AudioDestinationMinkar(const CreationOptions& options)
+    : AudioDestinationResampler(options, kDeviceSampleRate)
+    , m_channels(std::min(2u, std::max(1u, options.numberOfOutputChannels)))
+{
+    AudioStreamBasicDescription format { };
+    format.mSampleRate = kDeviceSampleRate;
+    format.mFormatID = kAudioFormatLinearPCM;
+    format.mFormatFlags = kAudioFormatFlagIsFloat | kAudioFormatFlagIsPacked;
+    format.mChannelsPerFrame = m_channels;
+    format.mBitsPerChannel = 32;
+    format.mBytesPerFrame = format.mBytesPerPacket = 4 * m_channels;
+    format.mFramesPerPacket = 1;
+    if (AudioQueueNewOutput(&format, queueCallback, this, nullptr, nullptr, 0, &m_queue) != noErr) {
+        m_queue = nullptr;
+        return;
+    }
+    for (unsigned i = 0; i < kBufferCount; ++i) {
+        AudioQueueBufferRef buffer = nullptr;
+        if (AudioQueueAllocateBuffer(m_queue, kBufferFrames * format.mBytesPerFrame, &buffer) == noErr)
+            m_buffers.append(buffer);
+    }
+    m_planes.resize(m_outputBus->numberOfChannels());
+    for (auto& plane : m_planes)
+        plane.resize(kBufferFrames);
+}
+
+AudioDestinationMinkar::~AudioDestinationMinkar()
+{
+    if (m_queue)
+        AudioQueueDispose(m_queue, true);
+}
+
+/* The graph's next frames into the buffer, queued again; silence when
+   stopped (the buffer then waits). */
+void AudioDestinationMinkar::fill(AudioQueueBufferRef buffer)
+{
+    if (!isPlaying())
+        return;
+    for (unsigned c = 0; c < m_planes.size(); ++c)
+        m_outputBus->setChannelMemory(c, m_planes[c].mutableSpan());
+    size_t frames = pullRendered(kBufferFrames);
+    render(m_sampleTime, MonotonicTime::fromMachAbsoluteTime(mach_absolute_time()), frames);
+    m_sampleTime += kBufferFrames;
+    float* out = static_cast<float*>(buffer->mAudioData);
+    for (unsigned i = 0; i < kBufferFrames; ++i) {
+        for (unsigned c = 0; c < m_channels; ++c) {
+            unsigned source = std::min<unsigned>(c, m_planes.size() - 1);
+            out[i * m_channels + c] = m_planes[source][i];
+        }
+    }
+    buffer->mAudioDataByteSize = kBufferFrames * 4 * m_channels;
+    AudioQueueEnqueueBuffer(m_queue, buffer, 0, nullptr);
+}
+
+void AudioDestinationMinkar::startRendering(CompletionHandler<void(bool)>&& completionHandler)
+{
+    if (!m_queue) {
+        callOnMainThread([completionHandler = WTF::move(completionHandler)]() mutable { completionHandler(false); });
+        return;
+    }
+    setIsPlaying(true);
+    for (auto buffer : m_buffers)
+        fill(buffer);
+    bool started = AudioQueueStart(m_queue, nullptr) == noErr;
+    if (!started)
+        setIsPlaying(false);
+    callOnMainThread([completionHandler = WTF::move(completionHandler), started]() mutable { completionHandler(started); });
+}
+
+void AudioDestinationMinkar::stopRendering(CompletionHandler<void(bool)>&& completionHandler)
+{
+    setIsPlaying(false);
+    if (m_queue)
+        AudioQueueStop(m_queue, true);
+    callOnMainThread([completionHandler = WTF::move(completionHandler)]() mutable { completionHandler(true); });
+}
+
+} // namespace WebCore
+
+#endif
