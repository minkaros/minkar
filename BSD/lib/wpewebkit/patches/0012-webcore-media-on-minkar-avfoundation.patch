+/* Web Audio's output on an audio queue: the graph's frames, resampled to
+   the device's rate (AudioDestinationResampler), interleaved into the
+   queue's buffers as it asks for them. */
+
+#pragma once
+
+#if ENABLE(WEB_AUDIO) && USE(MINKAR_MEDIA)
+
+#include "AudioDestinationResampler.h"
+#include <wtf/ThreadSafeRefCounted.h>
+#include <wtf/Vector.h>
+
+typedef struct OpaqueAudioQueue* AudioQueueRef;
+typedef struct AudioQueueBuffer* AudioQueueBufferRef;
+
+namespace WebCore {
+
+class AudioDestinationMinkar final : public AudioDestinationResampler, public ThreadSafeRefCounted<AudioDestinationMinkar, WTF::DestructionThread::Main> {
+public:
+    void ref() const final { ThreadSafeRefCounted<AudioDestinationMinkar, WTF::DestructionThread::Main>::ref(); }
+    void deref() const final { ThreadSafeRefCounted<AudioDestinationMinkar, WTF::DestructionThread::Main>::deref(); }
+
+    explicit AudioDestinationMinkar(const CreationOptions&);
+    ~AudioDestinationMinkar();
+
+    void fill(AudioQueueBufferRef);
+
+private:
+    void startRendering(CompletionHandler<void(bool)>&&) final;
+    void stopRendering(CompletionHandler<void(bool)>&&) final;
+
+    AudioQueueRef m_queue { nullptr };
+    Vector<AudioQueueBufferRef> m_buffers;
+    Vector<Vector<float>> m_planes;
+    unsigned m_channels { 2 };
+    double m_sampleTime { 0 };
+};
+
+} // namespace WebCore
+
+#endif
