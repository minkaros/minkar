WTF: the WPE port on a Darwin kernel

WPE's WTF sources assume Linux for the memory footprint, process memory
status and thread priorities. On Darwin they come from the task's VM
information and Mach exception ports (generated by mig), as in the JSCOnly
port. Accelerate stays with the Cocoa ports. CompactPointerTuple.h
includes <mach/vm_types.h>, which MACH_VM_MAX_ADDRESS needs, as Packed.h
does.

--- a/Source/WTF/wtf/PlatformWPE.cmake	2026-11-10 11:13:40.064953251 -0500
+++ b/Source/WTF/wtf/PlatformWPE.cmake	2026-11-10 11:13:41.029973487 -0500
@@ -20,9 +20,6 @@
     glib/TimeZoneGLib.cpp
     glib/URLGLib.cpp
 
-    linux/CurrentProcessMemoryStatus.cpp
-    linux/HighPriorityThreads.cpp
-
     posix/CPUTimePOSIX.cpp
     posix/FileHandlePOSIX.cpp
     posix/FileSystemPOSIX.cpp
@@ -42,8 +39,35 @@
         generic/MemoryFootprintGeneric.cpp
         generic/MemoryPressureHandlerGeneric.cpp
     )
+elseif (APPLE)
+    # Darwin kernel: memory footprint from the task's VM info, and Mach
+    # exception ports for the signal handlers (as in the JSCOnly port).
+    file(COPY mac/MachExceptions.defs DESTINATION ${WTF_DERIVED_SOURCES_DIR})
+    add_custom_command(
+        OUTPUT
+            ${WTF_DERIVED_SOURCES_DIR}/MachExceptionsServer.h
+            ${WTF_DERIVED_SOURCES_DIR}/mach_exc.h
+            ${WTF_DERIVED_SOURCES_DIR}/mach_excServer.c
+            ${WTF_DERIVED_SOURCES_DIR}/mach_excUser.c
+        MAIN_DEPENDENCY mac/MachExceptions.defs
+        WORKING_DIRECTORY ${WTF_DERIVED_SOURCES_DIR}
+        COMMAND ${Mig_EXECUTABLE} -header mach_exc.h -user mach_excUser.c
+            -sheader MachExceptionsServer.h -server mach_excServer.c
+            -DMACH_EXC_SERVER_TASKIDTOKEN_STATE -isysroot ${CMAKE_OSX_SYSROOT}
+            MachExceptions.defs
+        VERBATIM)
+    list(APPEND WTF_SOURCES
+        cocoa/MemoryFootprintCocoa.cpp
+
+        generic/MemoryPressureHandlerGeneric.cpp
+
+        ${WTF_DERIVED_SOURCES_DIR}/mach_excServer.c
+        ${WTF_DERIVED_SOURCES_DIR}/mach_excUser.c
+    )
 else ()
     list(APPEND WTF_SOURCES
+        linux/CurrentProcessMemoryStatus.cpp
+        linux/HighPriorityThreads.cpp
         linux/MemoryFootprintLinux.cpp
 
         unix/MemoryPressureHandlerUnix.cpp
--- a/Source/WTF/wtf/PlatformUse.h	2026-11-10 11:13:40.597964430 -0500
+++ b/Source/WTF/wtf/PlatformUse.h	2026-11-10 11:13:41.022973341 -0500
@@ -124,7 +124,7 @@
 #define USE_PTHREADS 1
 #endif
 
