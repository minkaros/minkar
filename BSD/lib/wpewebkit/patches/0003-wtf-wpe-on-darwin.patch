 #define USE_ACCELERATE 1
 #endif
 
--- a/Source/WTF/wtf/CompactPointerTuple.h	2026-11-10 11:13:40.022952370 -0500
+++ b/Source/WTF/wtf/CompactPointerTuple.h	2026-11-10 11:13:41.014973174 -0500
@@ -33,6 +33,7 @@
 #include <wtf/StdLibExtras.h>
 
 #if OS(DARWIN)
