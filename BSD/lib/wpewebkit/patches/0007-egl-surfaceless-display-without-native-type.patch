EGL: the surfaceless display opened with a null native display

eglGetPlatformDisplay takes a pointer as the native display. Mesa's
EGL_DEFAULT_DISPLAY is a native display type, an int on Darwin, which C++
does not convert to a pointer; the surfaceless platform takes null.

--- a/Source/WebCore/platform/graphics/egl/PlatformDisplaySurfaceless.cpp	2026-11-10 11:13:40.189955872 -0500
+++ b/Source/WebCore/platform/graphics/egl/PlatformDisplaySurfaceless.cpp	2026-11-10 11:13:41.060974134 -0500
@@ -39,9 +39,9 @@
 
     RefPtr<GLDisplay> glDisplay;
     if (GLContext::isExtensionSupported(extensions, "EGL_EXT_platform_base"))
-        glDisplay = GLDisplay::create(eglGetPlatformDisplayEXT(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr));
+        glDisplay = GLDisplay::create(eglGetPlatformDisplayEXT(EGL_PLATFORM_SURFACELESS_MESA, nullptr, nullptr));
     else if (GLContext::isExtensionSupported(extensions, "EGL_KHR_platform_base"))
-        glDisplay = GLDisplay::create(eglGetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr));
+        glDisplay = GLDisplay::create(eglGetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, nullptr, nullptr));
 
     if (!glDisplay) {
         WTFLogAlways("Could not create surfaceless EGL display: %s. Aborting...", GLContext::lastErrorString());
