WebCore: Web Crypto keys on libgcrypt for WPE on Darwin

The keys use CommonCrypto on every Darwin port but GTK. WPE uses libgcrypt
there as well, as on its other systems.

--- a/Source/WebCore/crypto/CryptoKey.cpp	2026-11-10 11:13:40.121954446 -0500
+++ b/Source/WebCore/crypto/CryptoKey.cpp	2026-11-10 11:13:41.041973737 -0500
@@ -76,7 +76,7 @@
     return WebCoreOpaqueRoot { key };
 }
 
-#if !OS(DARWIN) || PLATFORM(GTK)
+#if !OS(DARWIN) || PLATFORM(GTK) || PLATFORM(WPE)
 Vector<uint8_t> CryptoKey::randomData(size_t size)
 {
     Vector<uint8_t> result(size);
