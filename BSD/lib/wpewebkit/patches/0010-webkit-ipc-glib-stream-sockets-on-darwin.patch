+// Reads what the socket has, and handles each whole frame in it. Returns
+// false once the connection has closed.
+bool Connection::readStreamFrames()
+{
+    while (true) {
+        Vector<uint8_t> chunk(s_streamReadSize);
+        GUniqueOutPtr<GError> error;
+        auto bytesRead = readBytesFromSocket(m_socket.get(), chunk, m_streamFileDescriptors, m_cancellable.get(), &error.outPtr());
+        if (bytesRead < 0) {
+            if (g_error_matches(error.get(), G_IO_ERROR, G_IO_ERROR_WOULD_BLOCK))
+                return true;
+            if (m_isConnected && !g_error_matches(error.get(), G_IO_ERROR, G_IO_ERROR_CONNECTION_CLOSED) && !g_error_matches(error.get(), G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                RELEASE_LOG_ERROR(IPC, "Error receiving IPC message on socket %d in process %d: %s", g_socket_get_fd(m_socket.get()), getpid(), error ? error->message : "control data truncated");
+            connectionDidClose();
+            return false;
+        }
+        if (!bytesRead) {
+            connectionDidClose();
+            return false;
+        }
+        m_streamInput.append(chunk.span().first(bytesRead));
+
+        while (m_streamInput.size() >= sizeof(StreamFrameHeader)) {
+            StreamFrameHeader header;
+            memcpy(&header, m_streamInput.span().data(), sizeof(header));
+            if (header.size > s_messageMaxSize || header.fileDescriptorCount > s_attachmentMaxAmount) {
+                RELEASE_LOG_FAULT(IPC, "readStreamFrames: bad frame (size %u, file descriptors %u)", header.size, header.fileDescriptorCount);
+                connectionDidClose();
+                return false;
+            }
+            if (m_streamInput.size() < sizeof(header) + header.size)
+                break;
+            // A frame's file descriptors come with its first byte, so they are here.
+            if (m_streamFileDescriptors.size() < header.fileDescriptorCount) {
+                RELEASE_LOG_FAULT(IPC, "readStreamFrames: a frame's file descriptors are missing");
+                connectionDidClose();
+                return false;
+            }
+            m_readBuffer.clear();
+            m_readBuffer.append(m_streamInput.span().subspan(sizeof(header), header.size));
+            m_streamInput.removeAt(0, sizeof(header) + header.size);
+            m_fileDescriptors.clear();
+            for (uint32_t i = 0; i < header.fileDescriptorCount; ++i)
+                m_fileDescriptors.append(WTF::move(m_streamFileDescriptors[i]));
+            m_streamFileDescriptors.removeAt(0, header.fileDescriptorCount);
+
+            auto decoder = createMessageDecoder();
+            if (!decoder) {
+                connectionDidClose();
+                return false;
+            }
+            processIncomingMessage(makeUniqueRefFromNonNullUniquePtr(WTF::move(decoder)));
+            if (!m_isConnected)
+                return false;
+        }
+    }
 }
 
+// The rest of a frame the socket took only part of, when it can take more;
+// the messages after it then.
+void Connection::sendPendingOutputBytes()
+{
+    m_writeSocketMonitor.start(m_socket.get(), G_IO_OUT, m_connectionQueue->runLoop(), m_cancellable.get(), [this, protectedThis = protect(*this)] (GIOCondition) -> gboolean {
+        // The monitor is not stopped from its own callback (that destroys it).
+        m_connectionQueue->dispatch([this, protectedThis = protect(*this)] {
+            m_writeSocketMonitor.stop();
+            if (!m_isConnected)
+                return;
+            while (!m_pendingOutputBytes.isEmpty()) {
+                GUniqueOutPtr<GError> error;
+                auto bytesWritten = g_socket_send(m_socket.get(), reinterpret_cast<const gchar*>(m_pendingOutputBytes.span().data()), m_pendingOutputBytes.size(), m_cancellable.get(), &error.outPtr());
+                if (bytesWritten > 0) {
+                    m_pendingOutputBytes.removeAt(0, bytesWritten);
+                    continue;
+                }
+                if (bytesWritten < 0 && g_error_matches(error.get(), G_IO_ERROR, G_IO_ERROR_WOULD_BLOCK)) {
+                    sendPendingOutputBytes();
+                    return;
+                }
+                if (bytesWritten < 0 && !g_error_matches(error.get(), G_IO_ERROR, G_IO_ERROR_CONNECTION_CLOSED) && !g_error_matches(error.get(), G_IO_ERROR, G_IO_ERROR_CANCELLED))
+                    RELEASE_LOG_ERROR(IPC, "Error sending IPC message on socket %d in process %d: %s", g_socket_get_fd(m_socket.get()), getpid(), error->message);
+                connectionDidClose();
+                return;
+            }
+            m_hasPendingOutputMessage = false;
+            sendOutgoingMessages();
+        });
+        return G_SOURCE_REMOVE;
+    });
+}
