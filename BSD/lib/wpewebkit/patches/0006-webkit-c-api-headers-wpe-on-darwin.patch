WebKit: the C API's headers for WPE on Darwin

WKNativeEvent.h takes NSEvent as the native event on Darwin unless GTK
builds it, and WKPagePrivate.h leaves out the key event function there.
WPE on Darwin is treated as GTK is.

--- a/Source/WebKit/UIProcess/API/C/WKNativeEvent.h	2026-11-10 11:13:40.373959732 -0500
+++ b/Source/WebKit/UIProcess/API/C/WKNativeEvent.h	2026-11-10 11:13:41.110975177 -0500
@@ -34,7 +34,7 @@
 extern "C" {
 #endif
 
-#if defined(__APPLE__) && !TARGET_OS_IPHONE && !defined(BUILDING_GTK__)
+#if defined(__APPLE__) && !TARGET_OS_IPHONE && !defined(BUILDING_GTK__) && !defined(BUILDING_WPE__)
 #ifdef __OBJC__
 @class NSEvent;
 #elif __cplusplus
--- a/Source/WebKit/UIProcess/API/C/WKPagePrivate.h	2026-11-10 11:13:40.388960046 -0500
+++ b/Source/WebKit/UIProcess/API/C/WKPagePrivate.h	2026-11-10 11:13:41.114975261 -0500
@@ -244,7 +244,7 @@
 typedef void (*WKPageDoAfterProcessingAllPendingMouseEventsFunction)(void* functionContext);
 WK_EXPORT void WKPageDoAfterProcessingAllPendingMouseEvents(WKPageRef page, void* context, WKPageDoAfterProcessingAllPendingMouseEventsFunction function);
 
-#if !defined(__APPLE__)
+#if !defined(__APPLE__) || defined(BUILDING_WPE__)
 typedef void (*WKPageDoAfterProcessingAllPendingKeyEventsFunction)(void* functionContext);
 WK_EXPORT void WKPageDoAfterProcessingAllPendingKeyEvents(WKPageRef page, void* context, WKPageDoAfterProcessingAllPendingKeyEventsFunction function);
 
