<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Default system configuration: the computer's names (ComputerName,
     HostName, LocalHostName), as scutil would set them. -->
<plist version="1.0">
<dict>
	<key>System</key>
	<dict>
		<key>System</key>
		<dict>
			<key>ComputerName</key>
			<string>Minkar</string>
			<key>HostName</key>
			<string>minkar</string>
		</dict>
		<key>Network</key>
		<dict>
			<key>HostNames</key>
			<dict>
				<key>LocalHostName</key>
				<string>minkar</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
