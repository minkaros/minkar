# Part of Minkar.
#
# Swift's runtime and standard library are cross-compiled for Minkar from
# the Linux build host: CMake is told it builds for Darwin, with the
# toolchain's clang and ld64 and the Minkar SDK.
set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SYSTEM_VERSION 19.6.0)
set(CMAKE_OSX_SYSROOT @SDK@)
set(CMAKE_OSX_DEPLOYMENT_TARGET 10.15)
set(CMAKE_OSX_ARCHITECTURES x86_64)
set(CMAKE_C_COMPILER @TC@/clang)
set(CMAKE_CXX_COMPILER @TC@/clang++)
set(CMAKE_AR @TC@/ar)
set(CMAKE_RANLIB @TC@/ranlib)
set(CMAKE_LIBTOOL @TC@/libtool)
set(CMAKE_LINKER @TC@/ld64)
set(CMAKE_INSTALL_NAME_TOOL @TC@/install_name_tool)
set(CMAKE_C_FLAGS_INIT "-fuse-ld=@TC@/ld64")
set(CMAKE_CXX_FLAGS_INIT "-fuse-ld=@TC@/ld64")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
