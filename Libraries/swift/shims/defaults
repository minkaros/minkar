# "defaults read FILE KEY": the one call Swift's CMake makes of it (the
# SDK's version), answered on the Linux build host.
import plistlib, sys
if len(sys.argv) == 4 and sys.argv[1] == "read":
    with open(sys.argv[2], "rb") as f:
        print(plistlib.load(f).get(sys.argv[3], ""))
